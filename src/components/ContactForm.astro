---
// src/components/ContactForm.astro
interface Props {
  originPage?: string;
  className?: string;
}

const { originPage = 'home', className = '' } = Astro.props;
---

<div class={`rounded-[24px] border border-black/10 bg-white p-7 sm:p-9 shadow-sm ${className}`}>
  
  <div class="mb-6">
    <h3 class="font-sora text-2xl font-bold text-background-13">
      Cuéntanos sobre tu empresa
    </h3>
    <p class="font-inter-tight text-xs sm:text-sm text-background-13/70 mt-1">
      Te responderemos en menos de 24 horas hábiles con una orientación inicial.
    </p>
  </div>

  <form id="lead-contact-form" class="space-y-4" action="/api/contact" method="POST">
    <!-- Hidden Origin Field for Analytics -->
    <input type="hidden" name="origin_page" value={originPage} id="form-origin-page" />
    <input type="hidden" name="submitted_at" value="" id="form-submitted-at" />

    <!-- Grid: Name + Company -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="contact-name" class="block font-ibm-plex-mono text-xs font-medium text-background-13 mb-1.5">
          Nombre completo <span class="text-opai-purple">*</span>
        </label>
        <input
          type="text"
          id="contact-name"
          name="name"
          required
          placeholder="Ej. Carlos Mendoza"
          class="w-full rounded-xl border border-black/10 bg-slate-50 px-4 py-3 text-sm text-background-13 font-inter-tight placeholder:text-background-13/40 focus:bg-white focus:border-opai-purple focus:outline-none focus:ring-2 focus:ring-opai-purple/20 transition-all"
        />
      </div>

      <div>
        <label for="contact-company" class="block font-ibm-plex-mono text-xs font-medium text-background-13 mb-1.5">
          Empresa / Proyecto
        </label>
        <input
          type="text"
          id="contact-company"
          name="company"
          placeholder="Ej. Acme Corp"
          class="w-full rounded-xl border border-black/10 bg-slate-50 px-4 py-3 text-sm text-background-13 font-inter-tight placeholder:text-background-13/40 focus:bg-white focus:border-opai-purple focus:outline-none focus:ring-2 focus:ring-opai-purple/20 transition-all"
        />
      </div>
    </div>

    <!-- Grid: Email + Phone -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="contact-email" class="block font-ibm-plex-mono text-xs font-medium text-background-13 mb-1.5">
          Correo corporativo <span class="text-opai-purple">*</span>
        </label>
        <input
          type="email"
          id="contact-email"
          name="email"
          required
          placeholder="carlos@empresa.com"
          class="w-full rounded-xl border border-black/10 bg-slate-50 px-4 py-3 text-sm text-background-13 font-inter-tight placeholder:text-background-13/40 focus:bg-white focus:border-opai-purple focus:outline-none focus:ring-2 focus:ring-opai-purple/20 transition-all"
        />
      </div>

      <div>
        <label for="contact-phone" class="block font-ibm-plex-mono text-xs font-medium text-background-13 mb-1.5">
          Teléfono / WhatsApp <span class="text-opai-purple">*</span>
        </label>
        <input
          type="tel"
          id="contact-phone"
          name="phone"
          required
          placeholder="+57 300 000 0000"
          class="w-full rounded-xl border border-black/10 bg-slate-50 px-4 py-3 text-sm text-background-13 font-inter-tight placeholder:text-background-13/40 focus:bg-white focus:border-opai-purple focus:outline-none focus:ring-2 focus:ring-opai-purple/20 transition-all"
        />
      </div>
    </div>

    <!-- Service Selector -->
    <div>
      <label for="contact-service" class="block font-ibm-plex-mono text-xs font-medium text-background-13 mb-1.5">
        ¿Qué servicio te interesa principalmente? <span class="text-opai-purple">*</span>
      </label>
      <select
        id="contact-service"
        name="service"
        required
        class="w-full rounded-xl border border-black/10 bg-slate-50 px-4 py-3 text-sm text-background-13 font-inter-tight focus:bg-white focus:border-opai-purple focus:outline-none focus:ring-2 focus:ring-opai-purple/20 transition-all"
      >
        <option value="" disabled selected>Selecciona una opción...</option>
        <option value="marketing">Marketing Digital & Ads (Meta / Google / Contenido)</option>
        <option value="web">Desarrollo Web & Landings de Alta Conversión</option>
        <option value="ia-automatizacion">IA + Automatización de Procesos y CRM</option>
        <option value="productos-digitales">Productos Digitales (SaaS, Portales, MVPs)</option>
        <option value="ecosistema-completo">Ecosistema Completo (Todo el Estudio)</option>
      </select>
    </div>

    <!-- Message -->
    <div>
      <label for="contact-message" class="block font-ibm-plex-mono text-xs font-medium text-background-13 mb-1.5">
        Cuéntanos brevemente sobre tu proyecto o necesidad
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="3"
        placeholder="¿Cuáles son tus objetivos comerciales o cuellos de botella actuales?"
        class="w-full rounded-xl border border-black/10 bg-slate-50 px-4 py-3 text-sm text-background-13 font-inter-tight placeholder:text-background-13/40 focus:bg-white focus:border-opai-purple focus:outline-none focus:ring-2 focus:ring-opai-purple/20 transition-all"
      ></textarea>
    </div>

    <!-- Submit Button -->
    <button
      type="submit"
      id="submit-btn"
      class="w-full flex items-center justify-center gap-2 bg-background-13 hover:bg-black text-white py-3.5 px-6 rounded-xl font-ibm-plex-mono text-sm font-semibold transition-all shadow-sm hover:shadow-md active:scale-[0.99]"
    >
      <span>Enviar Solicitud de Proyecto</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </button>

    <!-- Success Message Container (Client state) -->
    <div id="form-success-msg" class="hidden rounded-xl border border-emerald-500/20 bg-emerald-50 p-4 text-center">
      <span class="font-sora text-sm font-bold text-emerald-800 block">¡Mensaje recibido con éxito!</span>
      <span class="font-inter-tight text-xs text-emerald-700 mt-1 block">Nos pondremos en contacto contigo a la brevedad.</span>
    </div>

    <p class="font-inter-tight text-[11px] text-background-13/50 text-center">
      Tus datos son 100% confidenciales. No enviamos spam.
    </p>

  </form>
</div>

<script>
  const form = document.getElementById('lead-contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success-msg');
  const submitBtn = document.getElementById('submit-btn');
  const submittedAtInput = document.getElementById('form-submitted-at') as HTMLInputElement | null;

  if (form) {
    if (submittedAtInput) {
      submittedAtInput.value = new Date().toISOString();
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (submitBtn) {
        submitBtn.innerHTML = '<span>Enviando información...</span>';
        submitBtn.setAttribute('disabled', 'true');
      }

      // Simulate clean submission or API dispatch
      setTimeout(() => {
        if (successMsg) successMsg.classList.remove('hidden');
        if (submitBtn) submitBtn.classList.add('hidden');
      }, 700);
    });
  }
</script>
