---
// src/components/ia/WorkflowDiagramSection.astro
import { Clock, ShieldCheck, Users, Zap, ArrowRight, Check } from 'lucide-astro';

const pipelineStages = [
  {
    time: "Segundo 0",
    title: "Contacto Multi-Canal",
    description: "Un prospecto calificado envía un mensaje por WhatsApp o llena el formulario web a las 10:45 PM.",
    actor: "Cliente Potencial",
    badge: "Inbound"
  },
  {
    time: "Segundo 5",
    title: "Clasificación & Scoring",
    description: "El agente IA analiza los requerimientos, consulta el CRM y determina el nivel de prioridad y servicio adecuado.",
    actor: "Agente IA RAG",
    badge: "Análisis Inteligente"
  },
  {
    time: "Segundo 15",
    title: "Respuesta & Agenda",
    description: "El cliente recibe la información precisa solicitada y un enlace interactivo para agendar llamada según disponibilidad.",
    actor: "Automatización Make/n8n",
    badge: "Cero Espera"
  },
  {
    time: "Día Siguiente",
    title: "Llamada de Cierre",
    description: "Tu asesor comercial llega a la reunión con el historial completo, resumen del caso y objeciones ya resueltas.",
    actor: "Asesor Humano",
    badge: "Venta Cerrada"
  }
];
---

<section class="py-24 bg-white relative overflow-hidden">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 font-ibm-plex-mono text-xs font-semibold uppercase tracking-wider text-emerald-600 mb-3">
        <span>// Anatomía de un Workflow Real</span>
      </div>
      <h2 class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
        De visitante a reunión calificada sin intervención manual.
      </h2>
      <p class="font-inter-tight text-lg text-background-13/75 leading-relaxed">
        Así funciona un ecosistema de automatización real: tu empresa atiende 24/7 sin que tu equipo tenga que estar conectado a medianoche.
      </p>
    </div>

    <!-- Interactive Pipeline Visual Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-14 relative">
      {pipelineStages.map((stage, idx) => (
        <div class="rounded-[24px] border border-stroke-2/60 bg-slate-50/70 p-6 flex flex-col justify-between relative transition-all hover:bg-white hover:shadow-md hover:border-black/20">
          
          <div>
            <!-- Stage Time & Badge -->
            <div class="flex items-center justify-between mb-4">
              <span class="font-ibm-plex-mono text-xs font-bold text-opai-purple bg-opai-purple/10 px-2.5 py-1 rounded-lg">
                {stage.time}
              </span>
              <span class="font-ibm-plex-mono text-[11px] text-background-13/50">
                Paso 0{idx + 1}
              </span>
            </div>

            <h3 class="font-sora text-lg font-bold text-background-13 mb-2">
              {stage.title}
            </h3>

            <p class="font-inter-tight text-xs sm:text-sm text-background-13/70 leading-relaxed mb-6">
              {stage.description}
            </p>
          </div>

          <!-- Bottom Actor Indicator -->
          <div class="pt-3.5 border-t border-black/5 font-ibm-plex-mono text-[11px] text-background-13/60 flex items-center justify-between">
            <span class="text-background-13/40">Ejecuta:</span>
            <span class="font-medium text-background-13">{stage.actor}</span>
          </div>

        </div>
      ))}
    </div>

    <!-- Key Principle Box: Humans + AI Synergy -->
    <div class="rounded-[24px] bg-background-13 text-white p-7 sm:p-9 border border-white/10 shadow-lg">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
        
        <div class="space-y-3 max-w-3xl">
          <div class="inline-flex items-center gap-2 font-ibm-plex-mono text-xs text-opai-purple uppercase font-semibold">
            <ShieldCheck class="h-4 w-4" /> Filosofía 77 Studio
          </div>
          <h3 class="font-sora text-2xl sm:text-3xl font-bold leading-snug">
            La automatización no reemplaza a tu equipo: multiplica su capacidad comercial.
          </h3>
          <p class="font-inter-tight text-sm sm:text-base text-white/70 leading-relaxed">
            Eliminamos las tareas repetitivas de copiar datos, enviar recordatorios y responder lo mismo 50 veces al día. Tu equipo se dedica a lo que realmente importa: negociar, cerrar y crear valor.
          </p>
        </div>

        <div class="shrink-0 flex flex-col sm:flex-row gap-4 w-full lg:w-auto">
          <a
            href="#contacto"
            class="w-full sm:w-auto text-center font-ibm-plex-mono text-xs uppercase tracking-wider bg-opai-purple hover:bg-opai-purple/90 text-white px-6 py-3.5 rounded-xl transition-all font-semibold"
          >
            Evaluar Procesos de mi Empresa
          </a>
        </div>

      </div>
    </div>

  </div>
</section>
