---
// src/components/ia/IACapabilitiesGrid.astro
import {
  TrendingUp,
  MessageCircle,
  FileSpreadsheet,
  BrainCircuit,
  ArrowRight
} from 'lucide-astro';

const capabilities = [
  {
    icon: TrendingUp,
    number: "01",
    title: "Automatización Comercial & CRM",
    badge: "Ventas & Conversión",
    description: "Conexión instantánea de leads a tu CRM, asignación inteligente de prospectos según país o presupuesto, y secuencias de seguimiento automatizadas por WhatsApp.",
    bullets: [
      "Distribución automática de leads por asesor",
      "Secuencias de nutrición y follow-up multicanal",
      "Actualización de pipeline en tiempo real"
    ],
    color: "text-blue-600 bg-blue-50"
  },
  {
    icon: MessageCircle,
    number: "02",
    title: "Atención & Soporte Contextual",
    badge: "Disponibilidad 24/7",
    description: "Asistentes virtuales entrenados con la información real de tu catálogo, servicios y políticas para responder dudas frecuentes y pre-calificar prospectos al instante.",
    bullets: [
      "Respuestas precisas en menos de 5 segundos",
      "Transferencia transparente a ejecutivos humanos",
      "Integración nativa con WhatsApp Business"
    ],
    color: "text-opai-purple bg-opai-purple/10"
  },
  {
    icon: FileSpreadsheet,
    number: "03",
    title: "Procesos & Operaciones Internas",
    badge: "Eficiencia Operativa",
    description: "Eliminamos el trabajo manual repetitivo: generación automática de propuestas en PDF, sincronización entre bases de datos y alertas operativas programadas.",
    bullets: [
      "Generación de cotizaciones y contratos en 1 clic",
      "Sincronización Sheets ↔ CRM ↔ Notificaciones",
      "Alertas automáticas de tareas y cobros"
    ],
    color: "text-emerald-600 bg-emerald-50"
  },
  {
    icon: BrainCircuit,
    number: "04",
    title: "Inteligencia Artificial Aplicada",
    badge: "IA con Sentido de Negocio",
    description: "Implementamos modelos de lenguaje (LLMs) y sistemas RAG para extraer datos de correos, calificar la intención de compra y consultar bases de conocimiento internas.",
    bullets: [
      "Extracción y estructuración de datos desordenados",
      "Scoring predictivo de probabilidad de cierre",
      "Búsqueda semántica en manuales y políticas"
    ],
    color: "text-amber-600 bg-amber-50"
  }
];
---

<section class="py-20 bg-slate-50 relative">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 font-ibm-plex-mono text-xs font-semibold uppercase tracking-wider text-opai-purple mb-3">
        <span>// Soluciones Tecnológicas Aplicadas</span>
      </div>
      <h2 class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
        4 áreas donde la automatización multiplica tus resultados.
      </h2>
      <p class="font-inter-tight text-lg text-background-13/70 leading-relaxed">
        No implementamos tecnología por moda. Cada flujo o agente resuelve una fricción operativa específica que ahorra horas de trabajo y previene la pérdida de clientes.
      </p>
    </div>

    <!-- 4 Capabilities Grid (2x2 Layout) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {capabilities.map((item) => (
        <div class="group relative rounded-[24px] border border-stroke-2/60 bg-white p-7 sm:p-8 shadow-sm transition-all duration-300 hover:shadow-lg hover:border-black/20 flex flex-col justify-between">
          
          <div>
            <div class="flex items-center justify-between mb-5">
              <div class={`flex h-12 w-12 items-center justify-center rounded-2xl ${item.color} transition-transform group-hover:scale-105`}>
                <item.icon class="h-6 w-6" />
              </div>
              <div class="flex items-center gap-2">
                <span class="font-ibm-plex-mono text-xs text-background-13/40">{item.number}</span>
                <span class="font-ibm-plex-mono text-xs px-2.5 py-1 rounded-full bg-slate-100 text-background-13/70 font-medium">
                  {item.badge}
                </span>
              </div>
            </div>

            <h3 class="font-sora text-2xl font-bold text-background-13 mb-3 group-hover:text-opai-purple transition-colors">
              {item.title}
            </h3>

            <p class="font-inter-tight text-sm sm:text-base text-background-13/70 leading-relaxed mb-6">
              {item.description}
            </p>

            <!-- Key Highlights List -->
            <ul class="space-y-2.5 font-inter-tight text-xs sm:text-sm text-background-13/80 mb-6">
              {item.bullets.map((bullet) => (
                <li class="flex items-center gap-2.5">
                  <span class="h-1.5 w-1.5 rounded-full bg-opai-purple"></span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-4 border-t border-black/5 flex items-center justify-between font-ibm-plex-mono text-xs text-background-13/50 group-hover:text-opai-purple transition-colors">
            <span>Diseñar este flujo para mi empresa</span>
            <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" />
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
