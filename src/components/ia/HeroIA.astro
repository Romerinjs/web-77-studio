---
// src/components/ia/HeroIA.astro
import DualCTA from '@/components/DualCTA.astro';
import { Zap, Bot, Database, MessageSquare } from 'lucide-astro';
import { getIaTranslations } from '@/lib/i18n/pages/ia-automatizacion';
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const t = getIaTranslations(currentLang);
---

<section 
  class="relative pt-36 pb-16 sm:pt-44 sm:pb-24 overflow-hidden bg-cover bg-center bg-no-repeat"
  style="background-image: url('/img/ia-automatizacion-hero.webp');"
>
  <!-- Higher White Tint / Opacity Overlay for Greater Clarity -->
  <div class="absolute inset-0 bg-white/80 backdrop-blur-[1px]"></div>

  <!-- Ambient Gradient Glow -->
  <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center opacity-30">
    <div class="h-[520px] w-[520px] rounded-full bg-gradient-to-tr from-opai-purple/15 to-transparent blur-[130px]"></div>
    <div class="h-[420px] w-[420px] rounded-full bg-gradient-to-bl from-indigo-500/10 to-transparent blur-[110px] -translate-y-20"></div>
  </div>

  <div class="mx-auto max-w-[1290px] px-4 sm:px-6 relative z-10">
    <div class="text-center max-w-4xl mx-auto">
      
      <!-- Main Headline -->
      <h1 data-text-reveal class="font-sora text-4xl sm:text-6xl lg:text-[62px] font-bold tracking-tight text-background-13 leading-[1.12] mb-6">
        {t.hero.headline}<span class="bg-gradient-to-r from-background-13 via-opai-purple to-background-13 bg-clip-text text-transparent">{t.hero.headlineHighlight}</span>
      </h1>

      <!-- Subheadline -->
      <p data-opai-animate data-delay="0.2" class="font-inter-tight text-lg sm:text-xl text-background-13/85 max-w-3xl mx-auto mb-9 leading-relaxed font-medium">
        {t.hero.subheadline}
      </p>

      <!-- Dual Commercial CTA (WhatsApp IA context + Contact form) -->
      <div data-opai-animate data-delay="0.3">
        <DualCTA
          whatsappContext="ia"
          whatsappText={t.hero.whatsappBtn}
          emailText={t.hero.emailBtn}
          emailHref="#contacto"
          centered={true}
          lang={currentLang}
        />
      </div>

    </div>

    <!-- 4 Standalone Separated Cards (Clean without top tags, Black Icon, White Card) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-12 max-w-5xl mx-auto">
      
      <!-- Card 1: Disparador -->
      <div data-opai-animate data-delay="0.1" class="rounded-2xl border border-black/10 bg-white/95 p-5 sm:p-6 backdrop-blur-md shadow-xs hover:shadow-md transition-all flex flex-col justify-between group">
        <div>
          <!-- Icon: White icon inside black background -->
          <div class="h-11 w-11 rounded-xl bg-background-13 text-white flex items-center justify-center mb-4 shadow-xs group-hover:scale-105 transition-transform">
            <Zap class="h-5 w-5 text-white" />
          </div>

          <h3 class="font-sora text-base sm:text-lg font-bold text-background-13 mb-2">
            {currentLang === 'en' ? 'Incoming Lead' : 'Lead Entrante'}
          </h3>

          <p class="font-inter-tight text-xs sm:text-sm text-background-13/75 leading-relaxed">
            {currentLang === 'en'
              ? 'Instant capture from Web Forms, Meta Ads, or WhatsApp campaigns.'
              : 'Captura desde Formulario Web, Anuncio de Meta Ads o WhatsApp.'}
          </p>
        </div>
      </div>

      <!-- Card 2: Agente IA -->
      <div data-opai-animate data-delay="0.2" class="rounded-2xl border border-black/10 bg-white/95 p-5 sm:p-6 backdrop-blur-md shadow-xs hover:shadow-md transition-all flex flex-col justify-between group">
        <div>
          <!-- Icon: White icon inside black background -->
          <div class="h-11 w-11 rounded-xl bg-background-13 text-white flex items-center justify-center mb-4 shadow-xs group-hover:scale-105 transition-transform">
            <Bot class="h-5 w-5 text-white" />
          </div>

          <h3 class="font-sora text-base sm:text-lg font-bold text-background-13 mb-2">
            {currentLang === 'en' ? 'Analysis & Scoring' : 'Análisis & Scoring'}
          </h3>

          <p class="font-inter-tight text-xs sm:text-sm text-background-13/75 leading-relaxed">
            {currentLang === 'en'
              ? 'Evaluates buying intent, extracts key variables, and scores the prospect.'
              : 'Evalúa la intención de compra, extrae datos clave y clasifica el lead.'}
          </p>
        </div>
      </div>

      <!-- Card 3: CRM Hub -->
      <div data-opai-animate data-delay="0.3" class="rounded-2xl border border-black/10 bg-white/95 p-5 sm:p-6 backdrop-blur-md shadow-xs hover:shadow-md transition-all flex flex-col justify-between group">
        <div>
          <!-- Icon: White icon inside black background -->
          <div class="h-11 w-11 rounded-xl bg-background-13 text-white flex items-center justify-center mb-4 shadow-xs group-hover:scale-105 transition-transform">
            <Database class="h-5 w-5 text-white" />
          </div>

          <h3 class="font-sora text-base sm:text-lg font-bold text-background-13 mb-2">
            {currentLang === 'en' ? 'CRM Synchronization' : 'Registro en CRM'}
          </h3>

          <p class="font-inter-tight text-xs sm:text-sm text-background-13/75 leading-relaxed">
            {currentLang === 'en'
              ? 'Creates contacts in HubSpot/Zoho with service tagging and budget attributes.'
              : 'Crea el contacto en HubSpot/Zoho con etiqueta de servicio y presupuesto.'}
          </p>
        </div>
      </div>

      <!-- Card 4: Acción -->
      <div data-opai-animate data-delay="0.4" class="rounded-2xl border border-black/10 bg-white/95 p-5 sm:p-6 backdrop-blur-md shadow-xs hover:shadow-md transition-all flex flex-col justify-between group">
        <div>
          <!-- Icon: White icon inside black background -->
          <div class="h-11 w-11 rounded-xl bg-background-13 text-white flex items-center justify-center mb-4 shadow-xs group-hover:scale-105 transition-transform">
            <MessageSquare class="h-5 w-5 text-white" />
          </div>

          <h3 class="font-sora text-base sm:text-lg font-bold text-background-13 mb-2">
            {currentLang === 'en' ? 'Human Closing' : 'Cierre Humano'}
          </h3>

          <p class="font-inter-tight text-xs sm:text-sm text-background-13/75 leading-relaxed">
            {currentLang === 'en'
              ? 'Instant alert to sales exec on WhatsApp with summarized briefing.'
              : 'Notificación instantánea a WhatsApp del vendedor con resumen listo.'}
          </p>
        </div>
      </div>

    </div>

  </div>
</section>
