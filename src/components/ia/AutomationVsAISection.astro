---
// src/components/ia/AutomationVsAISection.astro
import { GitBranch, BrainCircuit, CheckCircle2, ChevronDown } from 'lucide-astro';
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const isEn = currentLang === 'en';

const automationTools = [
  { name: "Make (Integromat)", logo: "/img/logos-platforms/make-automation-expert-logo.png" },
  { name: "n8n Workflow Engine", logo: "/img/logos-platforms/n8n-icon.webp" },
  { name: "Zapier Automations", logo: "/img/logos-platforms/zapier.png" }
];

const aiTools = [
  { name: "OpenAI GPT-4o", logo: "/img/logos-platforms/openai-logo.webp" },
  { name: "Anthropic Claude", logo: "/img/logos-platforms/claude-logo.png" },
  { name: "LangChain Framework", logo: "/img/logos-platforms/langchain-logo.png" }
];
---

<section class="py-20 bg-slate-50 relative">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header (Centered) -->
    <div class="text-center max-w-4xl mx-auto mb-16">
      <h2 data-text-reveal class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
        {isEn ? "Deterministic Automation vs. AI: What does your business actually need?" : "Automatización vs. Inteligencia Artificial: ¿Cuál necesita tu empresa?"}
      </h2>
      <p data-opai-animate data-delay="0.2" class="font-inter-tight text-base sm:text-lg text-background-13/75 leading-relaxed max-w-3xl mx-auto">
        {isEn
          ? "Many agencies push expensive 'AI' for things that only require robust deterministic logic. We clarify the difference so you invest strictly in high-ROI systems."
          : "Muchas agencias venden 'IA' para cosas que solo requieren una buena automatización lógica. Te explicamos la diferencia para que inviertas exactamente en lo que genera retorno."}
      </p>
    </div>

    <!-- Comparative Columns Grid with Accordion Behavior (Both Closed Initially) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12 items-start" id="automation-ai-grid">
      
      <!-- Column 1: Deterministic Automation -->
      <div data-opai-animate data-delay="0.1" class="accordion-compare-card group rounded-[24px] border border-stroke-2/60 bg-white p-7 sm:p-9 shadow-sm hover:shadow-lg hover:border-black/20 transition-all duration-300 flex flex-col justify-between cursor-pointer select-none">
        <div>
          <!-- Header: Black Icon with White Vector + Clean Title + Accordion Toggle -->
          <div class="flex items-center justify-between pb-5 mb-4 border-b border-black/5">
            <div class="flex items-center gap-3.5">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-background-13 text-white shadow-xs group-hover:scale-105 transition-transform">
                <GitBranch class="h-6 w-6 text-white" />
              </div>
              <div>
                <h3 class="font-sora text-2xl font-bold text-background-13 group-hover:text-blue-600 transition-colors">
                  {isEn ? "Deterministic Automation" : "Automatización"}
                </h3>
              </div>
            </div>

            <!-- Accordion Toggle Chevron -->
            <div class="accordion-chevron p-2 rounded-full bg-black/5 group-hover:bg-blue-50 group-hover:text-blue-600 text-background-13/60 transition-all duration-300">
              <ChevronDown class="h-4 w-4" />
            </div>
          </div>

          <!-- Expandable Content (Description, Principle & Bullets) -->
          <div class="accordion-content grid grid-rows-[0fr] transition-all duration-300 ease-out">
            <div class="overflow-hidden">
              <div class="pt-2 pb-4">
                <div class="font-sora text-base font-bold text-background-13 mb-3">
                  {isEn ? 'Principle: "If trigger A occurs, execute action B with zero error."' : 'Principio: "Si ocurre A, ejecuta B de forma exacta y sin error."'}
                </div>

                <p class="font-inter-tight text-sm text-background-13/75 mb-6 leading-relaxed">
                  {isEn
                    ? "Connects systems via strict deterministic logic. It doesn't need to guess or interpret; it executes mechanical operations at light speed with 100% precision."
                    : "Conecta sistemas mediante reglas fijas. No necesita pensar ni interpretar; ejecuta acciones mecánicas a la velocidad de la luz con cero margen de desviación."}
                </p>

                <div class="space-y-3 font-inter-tight text-sm text-background-13/80">
                  <div class="p-3 rounded-xl bg-slate-50 border border-black/5 flex items-center gap-2.5">
                    <CheckCircle2 class="h-4 w-4 text-blue-600 shrink-0" />
                    <span>{isEn ? "Payment and invoice synchronization with ERP / accounting software" : "Sincronización de pagos y facturas con tu software contable"}</span>
                  </div>
                  <div class="p-3 rounded-xl bg-slate-50 border border-black/5 flex items-center gap-2.5">
                    <CheckCircle2 class="h-4 w-4 text-blue-600 shrink-0" />
                    <span>{isEn ? "Instant automated transactional notifications via WhatsApp and email" : "Envío automático de confirmaciones por WhatsApp y email"}</span>
                  </div>
                  <div class="p-3 rounded-xl bg-slate-50 border border-black/5 flex items-center gap-2.5">
                    <CheckCircle2 class="h-4 w-4 text-blue-600 shrink-0" />
                    <span>{isEn ? "Task creation and assignment in CRM, Trello, or ClickUp" : "Creación y asignación de tareas en CRM / Trello / ClickUp"}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Centered Platform Logos with Tooltip (Make, n8n, Zapier) -->
        <div class="mt-6 pt-5 border-t border-black/5">
          <div class="flex items-center justify-center gap-8 sm:gap-10">
            {automationTools.map((tool) => (
              <div class="relative group/tool flex items-center justify-center cursor-pointer" title={tool.name}>
                <img 
                  src={tool.logo} 
                  alt={tool.name} 
                  class="h-7 sm:h-8 w-auto max-w-[90px] object-contain opacity-75 hover:opacity-100 hover:scale-110 transition-all duration-200" 
                />
                <!-- Floating Tooltip -->
                <div class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 opacity-0 group-hover/tool:opacity-100 transition-all duration-200 bg-background-13 text-white text-[11px] font-ibm-plex-mono py-1 px-2.5 rounded-lg whitespace-nowrap shadow-md z-30">
                  {tool.name}
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- Column 2: Applied AI & Language Models -->
      <div data-opai-animate data-delay="0.2" class="accordion-compare-card group rounded-[24px] border border-stroke-2/60 bg-white p-7 sm:p-9 shadow-sm hover:shadow-lg hover:border-black/20 transition-all duration-300 flex flex-col justify-between cursor-pointer select-none">
        <div>
          <!-- Header: Black Icon with White Vector + Clean Title + Accordion Toggle -->
          <div class="flex items-center justify-between pb-5 mb-4 border-b border-black/5">
            <div class="flex items-center gap-3.5">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-background-13 text-white shadow-xs group-hover:scale-105 transition-transform">
                <BrainCircuit class="h-6 w-6 text-white" />
              </div>
              <div>
                <h3 class="font-sora text-2xl font-bold text-background-13 group-hover:text-opai-purple transition-colors">
                  {isEn ? "Applied Artificial Intelligence" : "Inteligencia Artificial"}
                </h3>
              </div>
            </div>

            <!-- Accordion Toggle Chevron -->
            <div class="accordion-chevron p-2 rounded-full bg-black/5 group-hover:bg-opai-purple/10 group-hover:text-opai-purple text-background-13/60 transition-all duration-300">
              <ChevronDown class="h-4 w-4" />
            </div>
          </div>

          <!-- Expandable Content (Description, Principle & Bullets) -->
          <div class="accordion-content grid grid-rows-[0fr] transition-all duration-300 ease-out">
            <div class="overflow-hidden">
              <div class="pt-2 pb-4">
                <div class="font-sora text-base font-bold text-background-13 mb-3">
                  {isEn ? 'Principle: "Analyze messy, unstructured context and reason logically."' : 'Principio: "Analiza información desordenada y extrae sentido."'}
                </div>

                <p class="font-inter-tight text-sm text-background-13/75 mb-6 leading-relaxed">
                  {isEn
                    ? "Understands human language, classifies customer intents, and reasons across complex documents before deciding what action to trigger."
                    : "Interpreta lenguaje humano, clasifica intención y razona sobre datos no estructurados antes de decidir qué respuesta o acción ejecutar."}
                </p>

                <div class="space-y-3 font-inter-tight text-sm text-background-13/80">
                  <div class="p-3 rounded-xl bg-slate-50 border border-black/5 flex items-center gap-2.5">
                    <CheckCircle2 class="h-4 w-4 text-opai-purple shrink-0" />
                    <span>{isEn ? "Natural voice note comprehension and complex lead inquiry parsing" : "Comprensión de mensajes de voz y textos complejos de clientes"}</span>
                  </div>
                  <div class="p-3 rounded-xl bg-slate-50 border border-black/5 flex items-center gap-2.5">
                    <CheckCircle2 class="h-4 w-4 text-opai-purple shrink-0" />
                    <span>{isEn ? "Semantic catalog and corporate knowledge retrieval (RAG systems)" : "Búsqueda semántica en bases de conocimiento y catálogos (RAG)"}</span>
                  </div>
                  <div class="p-3 rounded-xl bg-slate-50 border border-black/5 flex items-center gap-2.5">
                    <CheckCircle2 class="h-4 w-4 text-opai-purple shrink-0" />
                    <span>{isEn ? "Automated requirement extraction from lengthy emails and RFPs" : "Extracción automática de requerimientos desde correos extensos"}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Centered Platform Logos with Tooltip (OpenAI, Claude, LangChain) -->
        <div class="mt-6 pt-5 border-t border-black/5">
          <div class="flex items-center justify-center gap-8 sm:gap-10">
            {aiTools.map((tool) => (
              <div class="relative group/tool flex items-center justify-center cursor-pointer" title={tool.name}>
                <img 
                  src={tool.logo} 
                  alt={tool.name} 
                  class="h-7 sm:h-8 w-auto max-w-[90px] object-contain opacity-75 hover:opacity-100 hover:scale-110 transition-all duration-200" 
                />
                <!-- Floating Tooltip -->
                <div class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 opacity-0 group-hover/tool:opacity-100 transition-all duration-200 bg-background-13 text-white text-[11px] font-ibm-plex-mono py-1 px-2.5 rounded-lg whitespace-nowrap shadow-md z-30">
                  {tool.name}
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<style>
  .accordion-compare-card.is-open {
    background-color: #ffffff;
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.08);
    border-color: rgba(0, 0, 0, 0.18);
  }

  .accordion-compare-card.is-open .accordion-chevron {
    transform: rotate(180deg);
  }

  .accordion-compare-card.is-open .accordion-content {
    grid-template-rows: 1fr;
  }
</style>

<script>
  function initCompareAccordion() {
    const grid = document.getElementById('automation-ai-grid');
    if (!grid) return;

    const cards = grid.querySelectorAll('.accordion-compare-card');

    cards.forEach((card) => {
      card.addEventListener('click', (e) => {
        // Prevent click when user interacts with logo tooltip
        const target = e.target as HTMLElement;
        if (target.closest('.group\\/tool')) return;

        card.classList.toggle('is-open');
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCompareAccordion);
  } else {
    initCompareAccordion();
  }
  document.addEventListener('astro:page-load', initCompareAccordion);
</script>
