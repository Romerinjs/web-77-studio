---
// src/components/contacto/HeroContacto.astro
import ContactForm from '@/components/ContactForm.astro';
import { getWhatsAppUrl } from '@/utils/whatsapp';
import { MessageSquare, Clock, ShieldCheck, Globe2, Sparkles } from 'lucide-astro';

const whatsappUrl = getWhatsAppUrl('contacto');
---

<section class="relative pt-32 pb-16 sm:pt-40 sm:pb-24 overflow-hidden">
  <!-- Ambient Gradient Glow -->
  <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center opacity-60">
    <div class="h-[500px] w-[500px] rounded-full bg-gradient-to-tr from-opai-purple/15 to-transparent blur-[130px]"></div>
    <div class="h-[400px] w-[400px] rounded-full bg-gradient-to-bl from-blue-500/10 to-transparent blur-[110px] -translate-y-20"></div>
  </div>

  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Header, WhatsApp & Direct Info -->
      <div class="lg:col-span-5 space-y-8">
        
        <div>
          <!-- Top Pill Badge -->
          <div class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white/90 px-4 py-1.5 backdrop-blur-md shadow-xs mb-6">
            <span class="h-2 w-2 rounded-full bg-opai-purple animate-pulse"></span>
            <span class="font-ibm-plex-mono text-xs font-medium tracking-wide text-background-13/80 uppercase">
              Módulo 07 · Contacto Directo · Colombia ↔ USA
            </span>
          </div>

          <!-- Headline -->
          <h1 class="font-sora text-4xl sm:text-5xl lg:text-[54px] font-bold tracking-tight text-background-13 leading-[1.14] mb-4">
            Hablemos de tu <span class="bg-gradient-to-r from-background-13 via-opai-purple to-background-13 bg-clip-text text-transparent">proyecto</span>.
          </h1>

          <!-- Subheadline -->
          <p class="font-inter-tight text-base sm:text-lg text-background-13/75 leading-relaxed">
            Ya sea que necesites escalar tu adquisición con Meta Ads, renovar tu web en Astro, automatizar flujos con IA o construir un producto digital a la medida, podemos empezar por una conversación directa.
          </p>
        </div>

        <!-- Prominent WhatsApp Commercial Card -->
        <div class="rounded-[24px] border border-opai-purple/30 bg-white p-7 shadow-[0_10px_30px_rgba(124,58,237,0.08)]">
          <div class="flex items-center gap-3 mb-4">
            <div class="h-10 w-10 rounded-xl bg-opai-purple text-white flex items-center justify-center shadow-xs">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
              </svg>
            </div>
            <div>
              <span class="font-sora font-bold text-base text-background-13 block leading-tight">
                ¿Prefieres hablar directamente?
              </span>
              <span class="font-ibm-plex-mono text-xs text-opai-purple font-medium">
                WhatsApp Business Oficial
              </span>
            </div>
          </div>

          <p class="font-inter-tight text-xs sm:text-sm text-background-13/70 mb-5 leading-relaxed">
            Cuéntanos brevemente qué necesitas y te orientamos sin rodeos sobre el mejor camino técnico y comercial desde el primer mensaje.
          </p>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center gap-2 bg-opai-purple hover:bg-opai-purple-hover text-white py-3.5 px-5 rounded-xl font-ibm-plex-mono text-sm font-semibold transition-all shadow-md active:scale-98"
          >
            <span>Abrir chat de WhatsApp</span>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <!-- Working Hours & International Support -->
        <div class="rounded-2xl border border-black/5 bg-slate-50 p-5 space-y-3 font-ibm-plex-mono text-xs text-background-13/70">
          <div class="flex items-center gap-2.5">
            <span class="text-emerald-500 font-bold text-sm">⚡</span>
            <span>Tiempo promedio de respuesta: &lt; 2 horas</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="text-blue-500 font-bold text-sm">📍</span>
            <span>Sedes: Colombia (GMT-5) · Estados Unidos (EST)</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="text-purple-500 font-bold text-sm">🔒</span>
            <span>Garantía de Confidencialidad (NDA bajo solicitud)</span>
          </div>
        </div>

      </div>

      <!-- Right Column: High-Converting Lead Form -->
      <div class="lg:col-span-7">
        <ContactForm originPage="contacto" />
      </div>

    </div>

  </div>
</section>
