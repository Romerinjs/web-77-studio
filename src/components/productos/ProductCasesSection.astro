---
// src/components/productos/ProductCasesSection.astro
const cases = [
  {
    type: "Plataforma SaaS B2B",
    title: "Sistema Multi-Tenant de Cotizaciones & Contratos",
    industry: "Sector Industrial & Proveedores",
    challenge: "Cotizaciones lentas enviadas por correos dispersos y seguimiento manual de propuestas en hojas de cálculo.",
    built: "Plataforma SaaS con generador dinámico de presupuestos, firma electrónica de contratos y pasarela de anticipos.",
    impact: "+350 Empresas Activas · -65% Tiempo en Emisión de Propuestas",
    tag: "SaaS"
  },
  {
    type: "Portal de Clientes",
    title: "Portal Privado de Autogestión & Pedidos Mayoristas",
    industry: "Distribución & Comercio Internacional",
    challenge: "Más de 400 consultas telefónicas diarias solicitando estado de pedidos, inventario disponible y facturas.",
    built: "Portal privado con catálogo en tiempo real, pedidos automáticos, estado de guías y descarga de facturas.",
    impact: "-70% Carga en Servicio al Cliente · +45% Pedidos Digitales",
    tag: "Portal"
  },
  {
    type: "Dashboard Ejecutivo",
    title: "Panel Financiero & Operativo en Tiempo Real",
    industry: "Grupo de Inversión & Retail",
    challenge: "Información financiera fragmentada en múltiples sucursales que tardaba 10 días en consolidarse a fin de mes.",
    built: "Dashboard centralizado conectado a bases de datos y pasarelas con actualización automática de márgenes y ventas.",
    impact: "Métricas en Tiempo Real · Alertas de Rentabilidad por Sucursal",
    tag: "Dashboard"
  },
  {
    type: "Herramienta Interna",
    title: "Web App para Control de Envíos & Bodega",
    industry: "Logística & Última Milla",
    challenge: "Pérdida de trazabilidad en despachos debido a registros manuales en papel y hojas de cálculo compartidas.",
    built: "Aplicación web responsiva con escaneo de código de barras, roles de bodeguero/conductor y panel de administración.",
    impact: "0 Errores de Registro · +1,200 Despachos Controlados al Mes",
    tag: "Internal Tool"
  }
];
---

<section class="py-20 sm:py-28 bg-slate-50 border-t border-black/5 relative">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-3.5 py-1 font-ibm-plex-mono text-xs text-opai-purple mb-4">
        <span>CASOS DE PRODUCTO REALES</span>
      </div>
      <h2 class="font-sora text-3xl sm:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-5">
        Herramientas construidas para resolver necesidades reales.
      </h2>
      <p class="font-inter-tight text-base sm:text-lg text-background-13/70 leading-relaxed">
        Diseñamos software que la gente disfruta usar. Cada pantalla, flujo y base de datos responde a un objetivo de negocio comprobado.
      </p>
    </div>

    <!-- Cases Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {cases.map((cs) => (
        <div class="rounded-[24px] border border-black/10 bg-white p-8 shadow-xs card-hover flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-ibm-plex-mono text-xs font-bold text-amber-700 bg-amber-50 px-3 py-1 rounded-lg border border-amber-200/60">
                {cs.type}
              </span>
              <span class="font-ibm-plex-mono text-xs text-background-13/50">
                {cs.industry}
              </span>
            </div>

            <h3 class="font-sora text-xl sm:text-2xl font-bold text-background-13 mb-4">
              {cs.title}
            </h3>

            <div class="space-y-3 mb-6 font-inter-tight text-sm text-background-13/75">
              <div>
                <strong class="text-background-13 font-semibold">El Reto: </strong>
                <span>{cs.challenge}</span>
              </div>
              <div>
                <strong class="text-background-13 font-semibold">Lo que Construimos: </strong>
                <span>{cs.built}</span>
              </div>
            </div>
          </div>

          <!-- Highlight Result Badge -->
          <div class="rounded-xl border border-amber-500/20 bg-amber-50/60 p-3.5 flex items-center gap-2.5">
            <span class="text-amber-600 font-bold text-base">⚡</span>
            <span class="font-ibm-plex-mono text-xs font-semibold text-amber-900">
              {cs.impact}
            </span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
