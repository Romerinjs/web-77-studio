---
// src/components/productos/ProductCasesSection.astro
import { ArrowRight, RotateCw } from 'lucide-astro';
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const isEn = currentLang === 'en';

const cases = [
  {
    title: isEn ? "Multi-Tenant Quotations & Contracts Engine" : "Sistema Multi-Tenant de Cotizaciones & Contratos",
    industry: isEn ? "Industrial Sector & Suppliers" : "Sector Industrial & Proveedores",
    challenge: isEn
      ? "Slow sales quotations scattered across disjointed emails and manual proposal tracking in spreadsheets."
      : "Cotizaciones lentas enviadas por correos dispersos y seguimiento manual de propuestas en hojas de cálculo.",
    built: isEn
      ? "SaaS platform featuring dynamic quote generators, e-signatures for contracts, and instant upfront payment processing."
      : "Plataforma SaaS con generador dinámico de presupuestos, firma electrónica de contratos y pasarela de anticipos.",
    impact: isEn ? "+350 Active Enterprises · -65% Proposal Turnaround Time" : "+350 Empresas Activas · -65% Tiempo en Emisión de Propuestas"
  },
  {
    title: isEn ? "Private Self-Service Portal & Wholesale Orders" : "Portal Privado de Autogestión & Pedidos Mayoristas",
    industry: isEn ? "Distribution & International Trade" : "Distribución & Comercio Internacional",
    challenge: isEn
      ? "Over 400 daily phone inquiries asking for order status, warehouse stock availability, and invoice copies."
      : "Más de 400 consultas telefónicas diarias solicitando estado de pedidos, inventario disponible y facturas.",
    built: isEn
      ? "Private customer portal with real-time stock catalog, automated dispatch tracking, and 1-click invoice downloads."
      : "Portal privado con catálogo en tiempo real, pedidos automáticos, estado de guías y descarga de facturas.",
    impact: isEn ? "-70% Customer Support Load · +45% Digital Wholesale Orders" : "-70% Carga en Servicio al Cliente · +45% Pedidos Digitales"
  },
  {
    title: isEn ? "Real-Time Operational & Financial Cockpit" : "Panel Financiero & Operativo en Tiempo Real",
    industry: isEn ? "Private Equity & Multi-Branch Retail" : "Grupo de Inversión & Retail",
    challenge: isEn
      ? "Fragmented accounting data across retail locations taking 10 business days to consolidate at month end."
      : "Información financiera fragmentada en múltiples sucursales que tardaba 10 días en consolidarse a fin de mes.",
    built: isEn
      ? "Centralized executive dashboard connected to databases and POS gateways with live gross margin and sales updates."
      : "Dashboard centralizado conectado a bases de datos y pasarelas con actualización automática de márgenes y ventas.",
    impact: isEn ? "Real-Time Unified Metrics · Branch Profitability Alerts" : "Métricas en Tiempo Real · Alertas de Rentabilidad por Sucursal"
  },
  {
    title: isEn ? "Warehouse & Last-Mile Dispatch Web App" : "Web App para Control de Envíos & Bodega",
    industry: isEn ? "Logistics & Supply Chain" : "Logística & Última Milla",
    challenge: isEn
      ? "Lost dispatch visibility due to manual paper logging and shared outdated spreadsheet entries."
      : "Pérdida de trazabilidad en despachos debido a registros manuales en papel y hojas de cálculo compartidas.",
    built: isEn
      ? "Responsive barcode-scanning web app with role management (picker, driver, manager) and central live tracking."
      : "Aplicación web responsiva con escaneo de código de barras, roles de bodeguero/conductor y panel de administración.",
    impact: isEn ? "0 Logging Errors · +1,200 Monthly Monitored Dispatches" : "0 Errores de Registro · +1,200 Despachos Controlados al Mes"
  }
];
---

<section class="py-20 sm:py-28 bg-slate-50 border-t border-black/5 relative overflow-hidden">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header (Centered) -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 data-text-reveal class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
        {isEn ? "Digital products engineered to solve real enterprise bottlenecks." : "Herramientas construidas para resolver necesidades reales."}
      </h2>
      <p data-opai-animate data-delay="0.2" class="font-inter-tight text-base sm:text-lg text-background-13/75 leading-relaxed max-w-2xl mx-auto">
        {isEn
          ? "We engineer software that people actually enjoy using. Every screen, workflow, and data structure serves a verified commercial objective."
          : "Diseñamos software que la gente disfruta usar. Cada pantalla, flujo y base de datos responde a un objetivo de negocio comprobado."}
      </p>
    </div>

    <!-- 3D Flip Coin Cases Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="flip-cards-grid">
      {cases.map((cs, index) => (
        <div 
          data-opai-animate
          data-delay={(0.1 * (index + 1)).toFixed(1)}
          class="flip-card-container group select-none min-h-[390px] sm:min-h-[410px]"
        >
          <div class="flip-card-inner relative w-full h-full">
            
            <!-- FRONT SIDE: EL RETO (NEGRO) -->
            <div class="flip-card-front absolute inset-0 rounded-[28px] border border-white/15 bg-[#0c0c14] text-white p-7 sm:p-9 shadow-xl flex flex-col justify-between">
              <div>
                <!-- Emphatic Badge for EL RETO -->
                <div class="flex items-center justify-between mb-5">
                  <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-red-500/20 border border-red-500/40 text-red-400 font-ibm-plex-mono text-xs font-bold uppercase tracking-wider shadow-xs">
                    <span class="size-2 rounded-full bg-red-400 animate-pulse"></span>
                    <span>{isEn ? "The Challenge" : "El Reto"}</span>
                  </div>
                  <span class="font-ibm-plex-mono text-xs text-white/60 font-medium">
                    {cs.industry}
                  </span>
                </div>

                <h3 class="font-sora text-xl sm:text-2xl font-bold text-white leading-snug pt-2">
                  {cs.challenge}
                </h3>
              </div>

              <!-- Flip Prompt Footer -->
              <div class="pt-4 border-t border-white/10 flex items-center justify-between font-ibm-plex-mono text-xs text-opai-purple">
                <span class="font-semibold flex items-center gap-1.5 group-hover:translate-x-1 transition-transform">
                  <span>{isEn ? "View Solution Developed" : "Ver Solución Desarrollada"}</span>
                  <ArrowRight class="size-3.5" />
                </span>
                <span class="text-white/50 text-[11px] flex items-center gap-1.5">
                  <RotateCw class="size-3 text-opai-purple" />
                  <span>{isEn ? "Flip card" : "Girar tarjeta"}</span>
                </span>
              </div>
            </div>

            <!-- BACK SIDE: LA SOLUCIÓN (BLANCO) -->
            <div class="flip-card-back absolute inset-0 rounded-[28px] border border-black/10 bg-white text-background-13 p-7 sm:p-9 shadow-xl flex flex-col justify-between">
              <div>
                <!-- Emphatic Badge for LA SOLUCIÓN -->
                <div class="flex items-center justify-between mb-5">
                  <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-700 font-ibm-plex-mono text-xs font-bold uppercase tracking-wider shadow-xs">
                    <span class="size-2 rounded-full bg-emerald-500"></span>
                    <span>{isEn ? "The Solution" : "La Solución"}</span>
                  </div>
                  <span class="font-ibm-plex-mono text-xs text-background-13/50 font-medium">
                    {cs.industry}
                  </span>
                </div>

                <h3 class="font-sora text-xl sm:text-2xl font-bold text-background-13 mb-3 leading-snug">
                  {cs.title}
                </h3>

                <p class="font-inter-tight text-sm sm:text-base text-background-13/80 leading-relaxed mb-4">
                  {cs.built}
                </p>

                <div class="rounded-xl border border-emerald-500/20 bg-emerald-50/50 p-3 font-ibm-plex-mono text-xs font-semibold text-background-13">
                  {cs.impact}
                </div>
              </div>

              <!-- Back Flip Prompt Footer -->
              <div class="pt-4 border-t border-black/5 flex items-center justify-between font-ibm-plex-mono text-xs text-background-13/60">
                <span class="text-opai-purple font-semibold flex items-center gap-1">
                  <span>{isEn ? "← Back to Challenge" : "← Volver al Reto"}</span>
                </span>
                <span class="text-background-13/50 text-[11px] flex items-center gap-1.5">
                  <RotateCw class="size-3 text-opai-purple" />
                  <span>{isEn ? "Flip card" : "Girar tarjeta"}</span>
                </span>
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .flip-card-container {
    perspective: 1200px;
  }

  .flip-card-inner {
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
    cursor: pointer;
  }

  /* Flip on hover for mouse users */
  .flip-card-container:hover .flip-card-inner,
  .flip-card-container.is-flipped .flip-card-inner {
    transform: rotateY(180deg);
  }

  .flip-card-front,
  .flip-card-back {
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .flip-card-back {
    transform: rotateY(180deg);
  }
</style>

<script>
  function initFlipCards() {
    const grid = document.getElementById('flip-cards-grid');
    if (!grid) return;

    const cards = grid.querySelectorAll('.flip-card-container');
    cards.forEach((card) => {
      card.addEventListener('click', () => {
        card.classList.toggle('is-flipped');
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFlipCards);
  } else {
    initFlipCards();
  }
  document.addEventListener('astro:page-load', initFlipCards);
</script>
