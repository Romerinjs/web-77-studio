---
// src/components/productos/ProductContactSection.astro
import ContactForm from '@/components/ContactForm.astro';
import { getWhatsAppUrl } from '@/utils/whatsapp';
import { Layers, Sparkles, CheckCircle2 } from 'lucide-astro';

const whatsappUrl = getWhatsAppUrl('productos');
---

<section id="contacto" class="py-20 sm:py-28 bg-slate-50 relative overflow-hidden border-t border-black/5">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Direct WhatsApp & Info -->
      <div class="lg:col-span-5 space-y-8">
        
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-3.5 py-1 font-ibm-plex-mono text-xs text-amber-700 mb-4">
            <span>CONSTRUCCIÓN DE PRODUCTO</span>
          </div>
          <h2 class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
            Cuéntanos qué herramienta necesitas crear.
          </h2>
          <p class="font-inter-tight text-base text-background-13/75 leading-relaxed">
            Puede ser una aplicación web interna para tu equipo, un portal de autogestión para tus clientes o una plataforma SaaS desde cero. Comencemos con una conversación de evaluación.
          </p>
        </div>

        <!-- Direct WhatsApp Card -->
        <div class="rounded-[24px] border border-amber-500/30 bg-white p-7 shadow-[0_10px_30px_rgba(245,158,11,0.08)]">
          <div class="flex items-center gap-3 mb-4">
            <div class="h-10 w-10 rounded-xl bg-amber-500 text-white flex items-center justify-center shadow-xs font-bold text-lg">
              ⚡
            </div>
            <div>
              <span class="font-sora font-bold text-base text-background-13 block leading-tight">
                Asesoría Técnica Directa
              </span>
              <span class="font-ibm-plex-mono text-xs text-amber-700 font-medium">
                Vía WhatsApp con Nuestro Equipo
              </span>
            </div>
          </div>

          <p class="font-inter-tight text-xs sm:text-sm text-background-13/70 mb-5 leading-relaxed">
            ¿Tienes bocetos, ideas o un proceso manual que quieras digitalizar? Cuéntanos por WhatsApp y te damos feedback técnico inmediato.
          </p>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center gap-2 bg-opai-purple hover:bg-opai-purple-hover text-white py-3 px-5 rounded-xl font-ibm-plex-mono text-sm font-semibold transition-all shadow-md active:scale-98"
          >
            <span>Conversar sobre mi producto</span>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <!-- Product Guarantee Highlights -->
        <div class="space-y-3 font-ibm-plex-mono text-xs text-background-13/60">
          <div class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>Acuerdo de Confidencialidad (NDA) antes de iniciar</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>Estimación de MVP en menos de 48 horas</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>Atención: Colombia (GMT-5) · USA (EST)</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Lead Form -->
      <div class="lg:col-span-7">
        <ContactForm originPage="productos-digitales" />
      </div>

    </div>

  </div>
</section>
