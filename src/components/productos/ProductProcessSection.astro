---
// src/components/productos/ProductProcessSection.astro
const steps = [
  {
    step: "01",
    title: "Problema & Requisitos",
    description: "Mapeamos el flujo de trabajo actual, identificamos los cuellos de botella y definimos con precisión qué debe resolver la herramienta antes de tirar una sola línea de código."
  },
  {
    step: "02",
    title: "Prototipos & Flujo UX/UI",
    description: "Creamos wireframes interactivos y el diseño visual de cada pantalla para que puedas ver y validar la experiencia de usuario y la lógica operativa antes del desarrollo."
  },
  {
    step: "03",
    title: "Desarrollo Ágil & Robusto",
    description: "Programamos la plataforma utilizando tecnologías modernas, seguras y escalables (Astro, TypeScript, Node.js, PostgreSQL y APIs REST/GraphQL)."
  },
  {
    step: "04",
    title: "Despliegue & Validación",
    description: "Configuramos los servidores cloud en Vercel o Dokploy, realizamos pruebas de seguridad y lanzamos la versión funcional para tu equipo o primeros usuarios."
  },
  {
    step: "05",
    title: "Iteración & Nuevos Módulos",
    description: "Analizamos el uso real de la herramienta e incorporamos mejoras continuas, nuevas automatizaciones y módulos adicionales a medida que tu empresa crece."
  }
];
---

<section class="py-20 sm:py-28 bg-white border-t border-black/5 relative">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header (Centered) -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 data-text-reveal class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
        De la necesidad a un producto funcional en 5 pasos.
      </h2>
      <p data-opai-animate data-delay="0.2" class="font-inter-tight text-base sm:text-lg text-background-13/75 leading-relaxed max-w-2xl mx-auto">
        Un proceso estructurado para construir herramientas digitales ágiles sin proyectos interminables ni desviaciones presupuestarias.
      </p>
    </div>

    <!-- 5 Steps Process Grid with Wide Spacing and Clean Structure -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 sm:gap-5">
      {steps.map((st, index) => (
        <div 
          data-opai-animate
          data-delay={(0.1 * (index + 1)).toFixed(1)}
          class="group rounded-[24px] border border-stroke-2/60 border-b-2 border-b-transparent bg-slate-50/70 p-6 sm:p-7 flex flex-col justify-start transition-all duration-300 hover:bg-white hover:shadow-md hover:border-black/20 hover:border-b-opai-purple"
        >
          <div class="flex items-center justify-between mb-5">
            <span class="font-ibm-plex-mono text-2xl sm:text-3xl font-bold text-opai-purple group-hover:scale-105 transition-transform">
              {st.step}
            </span>
          </div>

          <h3 class="font-sora text-lg sm:text-xl font-bold text-background-13 mb-3 group-hover:text-opai-purple transition-colors leading-snug">
            {st.title}
          </h3>

          <p class="font-inter-tight text-xs sm:text-sm text-background-13/75 leading-relaxed">
            {st.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
