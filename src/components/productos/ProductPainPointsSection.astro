---
// src/components/productos/ProductPainPointsSection.astro
import DualCTA from '@/components/DualCTA.astro';
import { XCircle, CheckCircle2, ArrowRight } from 'lucide-astro';

const genericProblems = [
  "Tu equipo tiene que adaptar sus procesos a la herramienta, en lugar de que el software se adapte a tu empresa.",
  "Pagas múltiples suscripciones mensuales que suben de precio cada vez que contratas a un nuevo colaborador.",
  "La información crítica de tu negocio queda atrapada en silos desconectados que requieren exportaciones manuales.",
  "Interfaces genéricas y sobrecargadas con cientos de botones que nadie usa y generan fricción diaria."
];

const studioAdvantages = [
  "Software diseñado exactamente para tus reglas de negocio, flujos comerciales y terminología interna.",
  "Código y base de datos de tu propiedad: escala a miles de usuarios sin tarifas abusivas por asiento.",
  "Integración total y directa con tu CRM, WhatsApp Business, pasarelas de cobro y sistemas existentes.",
  "Experiencia de usuario (UX/UI) minimalista, intuitiva y rápida que tu equipo adoptará desde el primer día."
];
---

<section class="py-20 sm:py-28 bg-slate-50 relative border-t border-black/5">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-3.5 py-1 font-ibm-plex-mono text-xs text-opai-purple mb-4">
        <span>DIAGNÓSTICO OPERATIVO</span>
      </div>
      <h2 class="font-sora text-3xl sm:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-5">
        Cuando el software comercial genérico queda corto.
      </h2>
      <p class="font-inter-tight text-base sm:text-lg text-background-13/70 leading-relaxed">
        Tu empresa no debería obligarse a encajar en plataformas rígidas. Si una necesidad operativa te frena o una idea de producto no existe en el mercado, la creamos para ti.
      </p>
    </div>

    <!-- Comparison 2-Columns Block -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-14 max-w-5xl mx-auto">
      
      <!-- Box 1: Generic Commercial Software -->
      <div class="rounded-[24px] border border-red-200/70 bg-white p-8 shadow-xs">
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-black/5">
          <div>
            <span class="font-ibm-plex-mono text-xs font-semibold text-red-600 uppercase tracking-wider block">
              Limitaciones Comunes
            </span>
            <h3 class="font-sora text-xl font-bold text-background-13 mt-1">
              Software Comercial Tradicional
            </h3>
          </div>
          <div class="h-9 w-9 rounded-xl bg-red-50 text-red-600 flex items-center justify-center font-bold text-base">
            ✕
          </div>
        </div>

        <ul class="space-y-4 font-inter-tight text-sm text-background-13/75">
          {genericProblems.map((prob) => (
            <li class="flex items-start gap-3">
              <span class="text-red-500 mt-0.5 text-base leading-none">✕</span>
              <span class="leading-relaxed">{prob}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Box 2: 77 Studio Custom Digital Product -->
      <div class="rounded-[24px] border-2 border-opai-purple bg-white p-8 shadow-[0_15px_40px_rgba(124,58,237,0.08)] relative">
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-black/5">
          <div>
            <span class="font-ibm-plex-mono text-xs font-bold text-opai-purple uppercase tracking-wider block">
              Enfoque Product Studio
            </span>
            <h3 class="font-sora text-xl font-bold text-background-13 mt-1">
              Solución a la Medida 77 Studio
            </h3>
          </div>
          <div class="h-9 w-9 rounded-xl bg-opai-purple text-white flex items-center justify-center font-bold text-base shadow-xs">
            ✓
          </div>
        </div>

        <ul class="space-y-4 font-inter-tight text-sm text-background-13/85">
          {studioAdvantages.map((adv) => (
            <li class="flex items-start gap-3">
              <span class="text-opai-purple font-bold mt-0.5 text-base leading-none">✓</span>
              <span class="leading-relaxed">{adv}</span>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Conversion Box -->
    <div class="rounded-2xl border border-black/10 bg-white p-8 text-center max-w-3xl mx-auto shadow-xs">
      <h3 class="font-sora text-xl sm:text-2xl font-bold text-background-13 mb-3">
        ¿Tienes un proceso manual o una idea de software para tu negocio?
      </h3>
      <p class="font-inter-tight text-sm sm:text-base text-background-13/70 mb-6 max-w-xl mx-auto">
        Evaluamos la viabilidad técnica y comercial de tu proyecto. Te orientamos sobre alcance, tiempos y presupuesto sin compromisos.
      </p>
      <DualCTA
        whatsappContext="productos"
        whatsappText="Quiero explorar una solución"
        emailText="Consultar por email"
        emailHref="#contacto"
      />
    </div>

  </div>
</section>
