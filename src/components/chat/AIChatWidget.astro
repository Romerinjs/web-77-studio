---
// src/components/chat/AIChatWidget.astro
import '@/styles/chat-widget.css';
import { getWhatsAppUrl, type WhatsAppContext } from '@/utils/whatsapp';

interface Props {
  whatsappContext?: WhatsAppContext;
  apiEndpoint?: string;
}

const {
  whatsappContext = 'home',
  apiEndpoint = '/api/chat'
} = Astro.props;

const fallbackWhatsAppUrl = getWhatsAppUrl(whatsappContext);
---

<div class="ai-chat-widget" id="aiChatWidget" data-api-endpoint={apiEndpoint} data-whatsapp-url={fallbackWhatsAppUrl} data-context={whatsappContext}>
  <!-- Botón Flotante Disparador -->
  <button class="chat-trigger-btn" id="chatTriggerBtn" aria-label="Abrir Asistente 77 Studio">
    <img src="/img/77studio.png" alt="77 Studio" onerror="this.src='https://77studio.co/wp-content/uploads/2026/08/77studio-scaled.png'" />
    <span class="trigger-online-dot" id="chatTriggerOnlineDot"></span>
    <span class="trigger-badge-count" id="triggerBadgeCount">1</span>
  </button>

  <!-- Ventana Flotante del Chat -->
  <div class="chat-window" id="chatWindow" role="dialog" aria-modal="true" aria-label="Chat de Soporte 77 Studio">
    <!-- Header -->
    <div class="chat-header">
      <div class="chat-header-info">
        <div class="chat-avatar-box">
          <img src="/img/77studio.png" alt="77 Studio" onerror="this.src='https://77studio.co/wp-content/uploads/2026/08/77studio-scaled.png'" />
          <span class="avatar-status-dot" id="chatAvatarStatusDot"></span>
        </div>
        <div>
          <div class="chat-bot-name">
            77 Studio <span class="bot-verified-badge" title="Agente Oficial Verificado">✓</span>
          </div>
          <div class="chat-bot-status" id="chatBotStatus">
            <span class="status-indicator" id="chatStatusDot">●</span> <span id="chatStatusText">Eve AI Conectado</span>
          </div>
        </div>
      </div>
      <div class="chat-header-actions">
        <button class="chat-action-btn" id="chatMinimizeBtn" aria-label="Minimizar chat" title="Minimizar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Cuerpo de Mensajes -->
    <div class="chat-body" id="chatBody"></div>

    <!-- Formulario Footer -->
    <form class="chat-footer-form" id="chatFooterForm">
      <input
        type="text"
        id="chatInputText"
        class="chat-input-text"
        placeholder="Escribe tu consulta o duda..."
        autocomplete="off"
        required
      />
      <button type="submit" class="chat-send-btn" id="chatSendBtn" aria-label="Enviar mensaje">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>
  </div>
</div>

<script src="@/scripts/chat-widget.ts"></script>
