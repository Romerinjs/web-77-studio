---
// src/components/MobileStickyBar.astro
interface Props {
  whatsappMessage?: string;
}

const { whatsappMessage = "Hola 77 Studio 👋 Vi su página web y quisiera conversar sobre un proyecto para mi empresa." } = Astro.props;
const whatsappUrl = `https://wa.me/573000000000?text=${encodeURIComponent(whatsappMessage)}`;
---

<div class="fixed bottom-0 left-0 z-40 flex w-full items-center justify-between gap-2 border-t border-black/10 bg-white/95 p-3 backdrop-blur-[15px] shadow-lg sm:hidden">
  <!-- WhatsApp Button -->
  <a 
    href={whatsappUrl} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-opai-purple py-3 font-ibm-plex-mono text-xs font-semibold text-white active:scale-[0.98] transition-transform"
  >
    <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c0-5.445 4.43-9.875 9.877-9.875 2.637 0 5.116 1.028 6.98 2.893a9.8 9.8 0 012.887 6.98c-.001 5.446-4.432 9.876-9.875 9.876"></path>
    </svg>
    <span>WhatsApp</span>
  </a>

  <!-- Email / Form Button -->
  <a 
    href="#contacto" 
    class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-[#0A0A0A] py-3 font-ibm-plex-mono text-xs font-semibold text-white active:scale-[0.98] transition-transform"
  >
    <svg class="h-4 w-4 stroke-current" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
    </svg>
    <span>Mensaje</span>
  </a>
</div>
