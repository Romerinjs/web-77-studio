---
// src/components/MobileStickyBar.astro
import { getWhatsAppUrl, type WhatsAppContext } from '@/utils/whatsapp';
import { uiTranslations, type SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  whatsappContext?: WhatsAppContext;
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const { whatsappContext = 'home' } = Astro.props;

const t = uiTranslations[currentLang];
const whatsappUrl = getWhatsAppUrl(whatsappContext, undefined, currentLang);
---

<aside
  id="mobile-sticky-bar"
  class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 px-4 py-2.5 backdrop-blur-md border-t border-black/10 shadow-[0_-4px_20px_rgba(0,0,0,0.08)] flex items-center gap-2.5"
  aria-label="Acciones directas de contacto"
>
  <!-- Botón WhatsApp -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex-1 flex items-center justify-center gap-2 bg-opai-purple text-white py-2.5 px-3 rounded-xl font-ibm-plex-mono text-xs font-semibold shadow-xs active:scale-95 transition-transform"
  >
    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
    </svg>
    <span>{t.cta.mobileWhatsapp}</span>
  </a>

  <!-- Botón Formulario / Contacto -->
  <a
    href="#contacto"
    class="flex-1 flex items-center justify-center gap-2 bg-background-13 text-white py-2.5 px-3 rounded-xl font-ibm-plex-mono text-xs font-semibold shadow-xs active:scale-95 transition-transform"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
    </svg>
    <span>{t.cta.mobileContact}</span>
  </a>
</aside>
