---
// src/components/marketing/HeroMarketing.astro
import DualCTA from '@/components/DualCTA.astro';
import { Target, TrendingUp, Sparkles, BarChart2 } from 'lucide-astro';
---

<section class="relative pt-36 pb-16 sm:pt-44 sm:pb-24 overflow-hidden">
  <!-- Ambient Gradient Glow -->
  <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center opacity-60">
    <div class="h-[520px] w-[520px] rounded-full bg-gradient-to-tr from-opai-purple/15 to-transparent blur-[130px]"></div>
    <div class="h-[420px] w-[420px] rounded-full bg-gradient-to-bl from-amber-400/10 to-transparent blur-[110px] -translate-y-20"></div>
  </div>

  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    <div class="text-center max-w-4xl mx-auto">
      
      <!-- Main Headline -->
      <h1 data-text-reveal class="font-sora text-4xl sm:text-6xl lg:text-[62px] font-bold tracking-tight text-background-13 leading-[1.12] mb-6">
        Marketing diseñado para <span class="bg-gradient-to-r from-background-13 via-opai-purple to-background-13 bg-clip-text text-transparent">hacer crecer</span> tu empresa.
      </h1>

      <!-- Subheadline -->
      <p data-opai-animate data-delay="0.2" class="font-inter-tight text-lg sm:text-xl text-background-13/75 max-w-3xl mx-auto mb-9 leading-relaxed">
        Integramos estrategia, Meta Ads, Google Ads, creatividad, contenido, branding y automatización para ayudar a empresas a atraer atención calificada, despertar demanda y cerrar más oportunidades comerciales.
      </p>

      <!-- Dual Commercial CTA (WhatsApp Marketing context + Contact form) -->
      <div data-opai-animate data-delay="0.3" class="mb-12">
        <DualCTA
          whatsappContext="marketing"
          whatsappText="Hablar por WhatsApp"
          emailText="Solicitar Propuesta de Marketing"
          emailHref="#contacto"
          centered={true}
        />
      </div>

    </div>

    <!-- Interactive Paid Media Dashboard Showcase -->
    <div data-opai-animate data-delay="0.4" class="mt-14 relative mx-auto max-w-5xl">
      <div class="relative rounded-[24px] border border-black/10 bg-white/95 p-4 sm:p-6 shadow-[0_20px_50px_-15px_rgba(0,0,0,0.08)] backdrop-blur-xl">
        
        <!-- Showcase Top Navigation Bar -->
        <div class="flex flex-wrap items-center justify-between border-b border-black/5 pb-4 gap-3">
          <div class="flex items-center gap-2">
            <div class="h-3 w-3 rounded-full bg-red-400/80"></div>
            <div class="h-3 w-3 rounded-full bg-amber-400/80"></div>
            <div class="h-3 w-3 rounded-full bg-emerald-400/80"></div>
            <span class="ml-2 font-ibm-plex-mono text-xs text-background-13/50">77-studio // performance-engine-v2.live</span>
          </div>

          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 font-ibm-plex-mono text-xs font-medium">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-ping"></span>
              Campañas en Escala Activa
            </span>
            <span class="hidden sm:inline-block font-ibm-plex-mono text-xs text-background-13/40">Colombia ↔ USA</span>
          </div>
        </div>

        <!-- 4 Key Performance Metrics Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5 pt-5 mb-5">
          
          <div data-opai-animate data-delay="0.1" class="rounded-2xl border border-black/5 bg-slate-50/80 p-3.5 transition-all hover:bg-white hover:shadow-xs">
            <div class="flex items-center justify-between mb-1.5 text-background-13/60">
              <span class="font-ibm-plex-mono text-[11px] uppercase tracking-wider font-medium">Retorno (ROAS)</span>
              <TrendingUp class="w-4 h-4 text-emerald-600" />
            </div>
            <div class="font-sora text-2xl font-bold text-background-13">4.62x</div>
            <div class="font-inter-tight text-xs text-emerald-600 font-medium mt-0.5">+48% vs Promedio Industria</div>
          </div>

          <div data-opai-animate data-delay="0.2" class="rounded-2xl border border-black/5 bg-slate-50/80 p-3.5 transition-all hover:bg-white hover:shadow-xs">
            <div class="flex items-center justify-between mb-1.5 text-background-13/60">
              <span class="font-ibm-plex-mono text-[11px] uppercase tracking-wider font-medium">Click-Through (CTR)</span>
              <Target class="w-4 h-4 text-opai-purple" />
            </div>
            <div class="font-sora text-2xl font-bold text-background-13">3.85%</div>
            <div class="font-inter-tight text-xs text-opai-purple font-medium mt-0.5">Creativos con Hook Testeado</div>
          </div>

          <div data-opai-animate data-delay="0.3" class="rounded-2xl border border-black/5 bg-slate-50/80 p-3.5 transition-all hover:bg-white hover:shadow-xs">
            <div class="flex items-center justify-between mb-1.5 text-background-13/60">
              <span class="font-ibm-plex-mono text-[11px] uppercase tracking-wider font-medium">Costo por Lead (CPL)</span>
              <BarChart2 class="w-4 h-4 text-blue-600" />
            </div>
            <div class="font-sora text-2xl font-bold text-background-13">-34.2%</div>
            <div class="font-inter-tight text-xs text-blue-600 font-medium mt-0.5">Optimización continua CAPI</div>
          </div>

          <div data-opai-animate data-delay="0.4" class="rounded-2xl border border-black/5 bg-slate-50/80 p-3.5 transition-all hover:bg-white hover:shadow-xs">
            <div class="flex items-center justify-between mb-1.5 text-background-13/60">
              <span class="font-ibm-plex-mono text-[11px] uppercase tracking-wider font-medium">Calidad de Leads</span>
              <Sparkles class="w-4 h-4 text-amber-500" />
            </div>
            <div class="font-sora text-2xl font-bold text-background-13">89.4%</div>
            <div class="font-inter-tight text-xs text-amber-600 font-medium mt-0.5">Filtro calificado y CRM</div>
          </div>

        </div>

        <!-- Real Campaign Stream Showcase -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          
          <!-- Campaign 1: Meta Demand Gen -->
          <div data-opai-animate data-delay="0.2" class="rounded-2xl border border-black/5 bg-slate-50 p-4">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-blue-500"></span>
                <span class="font-ibm-plex-mono text-xs font-semibold text-background-13">Meta Ads // Demand Gen & Reels</span>
              </div>
              <span class="font-ibm-plex-mono text-[10px] px-2 py-0.5 rounded-md bg-blue-100 text-blue-800">Top of Funnel</span>
            </div>
            <p class="font-inter-tight text-xs text-background-13/70 mb-3">
              Pruebas de hooks visuales de 3 segundos + audiencias de intención en Instagram y Facebook.
            </p>
            <div class="flex items-center justify-between text-xs font-ibm-plex-mono bg-white p-2.5 rounded-xl border border-black/5">
              <span class="text-background-13/70">Atribución Server-side:</span>
              <span class="font-semibold text-emerald-600">Meta Conversions API (100%)</span>
            </div>
          </div>

          <!-- Campaign 2: Google Search Intent -->
          <div data-opai-animate data-delay="0.3" class="rounded-2xl border border-black/5 bg-slate-50 p-4">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                <span class="font-ibm-plex-mono text-xs font-semibold text-background-13">Google Ads // High-Intent Search</span>
              </div>
              <span class="font-ibm-plex-mono text-[10px] px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800">Bottom of Funnel</span>
            </div>
            <p class="font-inter-tight text-xs text-background-13/70 mb-3">
              Captura exacta del usuario que busca activamente soluciones comerciales listas para contratar.
            </p>
            <div class="flex items-center justify-between text-xs font-ibm-plex-mono bg-white p-2.5 rounded-xl border border-black/5">
              <span class="text-background-13/70">Tasa de Conversión Landing:</span>
              <span class="font-semibold text-opai-purple">14.8% a WhatsApp/Form</span>
            </div>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>
