---
// src/components/marketing/CapabilitiesGrid.astro
import {
  Compass,
  Share2,
  Search,
  Palette,
  LayoutGrid,
  Video,
  Sparkles,
  CalendarCheck,
  Mail,
  MessageSquare
} from 'lucide-astro';
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const isEn = currentLang === 'en';

const capabilities = isEn ? [
  {
    icon: Compass,
    number: "01",
    title: "Strategy & Positioning",
    description: "Definition of commercial goals, ICP buyer personas, differentiated value proposition, and customer acquisition channels."
  },
  {
    icon: Share2,
    number: "02",
    title: "Meta Ads (Instagram & FB)",
    description: "Demand generation campaigns, Advantage+ setups, high-value audiences, and omni-channel dynamic retargeting."
  },
  {
    icon: Search,
    number: "03",
    title: "Google Ads & High-Intent Search",
    description: "Capturing ready-to-buy search intent through Google Search, Performance Max, and conversion keyword optimization."
  },
  {
    icon: Palette,
    number: "04",
    title: "Branding & Communication",
    description: "Visual identity, design systems, and brand storytelling to build instant authority and buyer confidence."
  },
  {
    icon: LayoutGrid,
    number: "05",
    title: "Content Production",
    description: "High-contrast graphic assets, educational carousels, and persuasive copy engineered to retain attention."
  },
  {
    icon: Video,
    number: "06",
    title: "Video Editing & Ad Hooks",
    description: "Shorts, Reels, and video ads with structured hooks in the first 3 seconds to maximize click-through rate (CTR)."
  },
  {
    icon: Sparkles,
    number: "07",
    title: "AI-Assisted Content Iteration",
    description: "Rapid generation of visual variations, alternative copy angles, and conceptual prototyping for constant A/B testing."
  },
  {
    icon: CalendarCheck,
    number: "08",
    title: "Publishing Automation",
    description: "Seamless content distribution and scheduling systems without manual friction or operational bottlenecks."
  },
  {
    icon: Mail,
    number: "09",
    title: "Email Marketing & Lead Nurturing",
    description: "Automated onboarding sequences, lead warming workflows, and commercial re-activation of past customer lists."
  },
  {
    icon: MessageSquare,
    number: "10",
    title: "Direct SMS & WhatsApp Marketing",
    description: "Direct messaging for strategic announcements, exclusive offers, and appointment reminders with +90% open rates."
  }
] : [
  {
    icon: Compass,
    number: "01",
    title: "Estrategia & Posicionamiento",
    description: "Definición de objetivos comerciales, audiencias ICP, propuesta de valor diferenciada y mapa de canales de adquisición."
  },
  {
    icon: Share2,
    number: "02",
    title: "Meta Ads (Instagram & FB)",
    description: "Campañas de generación de demanda, Advantage+, audiencias de alto valor y retargeting dinámico omnicanal."
  },
  {
    icon: Search,
    number: "03",
    title: "Google Ads & High-Intent Search",
    description: "Captura de intención de búsqueda lista para comprar mediante Search, Performance Max y optimización de palabras clave."
  },
  {
    icon: Palette,
    number: "04",
    title: "Branding & Comunicación",
    description: "Identidad visual, directrices de diseño y narrativa de marca para generar autoridad y confianza inmediata."
  },
  {
    icon: LayoutGrid,
    number: "05",
    title: "Generación de Contenido",
    description: "Piezas gráficas de alto contraste, carruseles de valor y copys persuasivos diseñados para retener y educar."
  },
  {
    icon: Video,
    number: "06",
    title: "Edición de Video & Hooks",
    description: "Reels, Shorts y anuncios de video con hooks estructurados en los primeros 3 segundos para maximizar el CTR."
  },
  {
    icon: Sparkles,
    number: "07",
    title: "Contenido con Asistencia de IA",
    description: "Generación rápida de variaciones visuales, copys alternativos y prototipado conceptual para pruebas A/B constantes."
  },
  {
    icon: CalendarCheck,
    number: "08",
    title: "Automatización de Publicaciones",
    description: "Sistemas de distribución y calendarización de contenido sin fricción manual ni cuellos de botella operativos."
  },
  {
    icon: Mail,
    number: "09",
    title: "Email Marketing & Nutrición",
    description: "Secuencias automáticas de bienvenida, maduración de leads y reactivación comercial de bases de datos existentes."
  },
  {
    icon: MessageSquare,
    number: "10",
    title: "SMS Marketing Directo",
    description: "Mensajería directa para alertas estratégicas, ofertas exclusivas y recordatorios de alta tasa de apertura (+90%)."
  }
];

const title = isEn
  ? "10 capabilities integrated into a single growth marketing team."
  : "10 capacidades integradas en un solo equipo de marketing.";

const subtitle = isEn
  ? "You don't need to hire 5 agencies or juggle disconnected freelancers. We unify all disciplines so your messaging, ads, and conversion funnel operate in complete sync."
  : "No necesitas contratar 5 agencias ni lidiar con freelancers desconectados. Unificamos todas las disciplinas para que tu mensaje, tus anuncios y tu embudo funcionen en sincronía.";
---

<section class="py-20 sm:py-28 bg-slate-50 relative border-t border-black/5">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header (Centered) -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 data-text-reveal class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
        {title}
      </h2>
      <p data-opai-animate data-delay="0.2" class="font-inter-tight text-base sm:text-lg text-background-13/75 leading-relaxed max-w-2xl mx-auto">
        {subtitle}
      </p>
    </div>

    <!-- 10 Capabilities Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {capabilities.map((item, index) => {
        const IconComponent = item.icon;
        const delay = ((index % 4) * 0.1).toFixed(1);
        return (
          <div 
            data-opai-animate 
            data-delay={delay}
            class="group relative rounded-[24px] border border-stroke-2/60 border-b-2 border-b-transparent bg-white p-7 sm:p-8 transition-all duration-300 hover:shadow-xl hover:border-black/20 hover:border-b-opai-purple flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between gap-4 mb-5">
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-background-13 text-white transition-transform group-hover:scale-105 shadow-xs">
                  <IconComponent class="h-6 w-6 text-white" />
                </div>
                <span class="font-ibm-plex-mono text-xl font-bold text-opai-purple">
                  {item.number}
                </span>
              </div>

              <h3 class="font-sora text-xl font-bold text-background-13 mb-2.5 group-hover:text-opai-purple transition-colors leading-snug">
                {item.title}
              </h3>

              <p class="font-inter-tight text-sm text-background-13/75 leading-relaxed">
                {item.description}
              </p>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
