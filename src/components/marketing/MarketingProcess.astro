---
// src/components/marketing/MarketingProcess.astro
import { Search, PenTool, Rocket, LineChart } from 'lucide-astro';

const steps = [
  {
    number: "01",
    icon: Search,
    title: "Entendemos",
    subtitle: "Diagnóstico & Estrategia",
    description: "Analizamos tu modelo de negocio, tu oferta comercial, tu cliente ideal (ICP) y los ángulos que tu competencia no está explotando.",
    deliverable: "Roadmap estratégico y selección de canales prioritarios"
  },
  {
    number: "02",
    icon: PenTool,
    title: "Diseñamos",
    subtitle: "Creatividad & Embudo",
    description: "Creamos los videos, anuncios gráficos, copys y la página de aterrizaje donde aterrizará el tráfico para garantizar máxima conversión.",
    deliverable: "Piezas publicitarias listas y landing optimizada"
  },
  {
    number: "03",
    icon: Rocket,
    title: "Lanzamos",
    subtitle: "Setup Técnico & Activación",
    description: "Configuramos Meta Conversions API (CAPI), Google Tag Manager, GA4 y activamos las campañas con presupuestos controlados.",
    deliverable: "Campañas activas con tracking del 100% de eventos"
  },
  {
    number: "04",
    icon: LineChart,
    title: "Optimizamos",
    subtitle: "A/B Testing & Escalado",
    description: "Monitoreamos métricas en tiempo real, apagamos lo que no funciona, duplicamos los creativos ganadores y escalamos el presupuesto.",
    deliverable: "Reportes claros de ROAS, CPL y nuevos clientes"
  }
];
---

<section class="py-20 bg-slate-50 relative">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 font-ibm-plex-mono text-xs font-semibold uppercase tracking-wider text-opai-purple mb-3">
        <span>// Metodología de Crecimiento</span>
      </div>
      <h2 class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
        Cómo llevamos tus campañas de 0 a escala en 4 pasos.
      </h2>
      <p class="font-inter-tight text-lg text-background-13/70 leading-relaxed">
        Un proceso estructurado, transparente y orientado a métricas de negocio reales, sin sorpresas ni experimentos a ciegas.
      </p>
    </div>

    <!-- 4 Steps Process Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step) => (
        <div class="rounded-[20px] border border-stroke-2/60 bg-white p-6 sm:p-7 flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow relative">
          
          <div>
            <!-- Step Number & Icon -->
            <div class="flex items-center justify-between mb-5">
              <span class="font-ibm-plex-mono text-2xl font-bold text-opai-purple/80">
                {step.number}
              </span>
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-opai-purple/10 text-opai-purple">
                <step.icon class="h-5 w-5" />
              </div>
            </div>

            <!-- Title & Subtitle -->
            <h3 class="font-sora text-xl font-bold text-background-13 mb-1">
              {step.title}
            </h3>
            <span class="font-ibm-plex-mono text-xs text-background-13/50 block mb-3 uppercase tracking-wider">
              {step.subtitle}
            </span>

            <!-- Description -->
            <p class="font-inter-tight text-sm text-background-13/75 leading-relaxed mb-6">
              {step.description}
            </p>
          </div>

          <!-- Bottom Deliverable Tag -->
          <div class="pt-4 border-t border-black/5 font-inter-tight text-xs text-background-13/70">
            <span class="font-semibold text-background-13 block mb-0.5">Entregable:</span>
            <span>{step.deliverable}</span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
