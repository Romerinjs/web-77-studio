---
// src/components/home/InternationalPresence.astro
---

<section class="relative py-20 sm:py-28 overflow-hidden bg-background-6">
  <!-- Background Image with Dark Overlay -->
  <div class="absolute inset-0 z-0 select-none pointer-events-none">
    <img
      src="/img/banner usa y col.png"
      alt="Presencia y Cobertura Global Colombia y Estados Unidos"
      class="w-full h-full object-cover opacity-60"
    />
    <div class="absolute inset-0 bg-black/60 backdrop-blur-[1px]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-[1290px] px-4 sm:px-6">
    <div class="text-center max-w-4xl mx-auto space-y-6">
      
      <span class="inline-block font-ibm-plex-mono text-xs font-semibold text-white/50 uppercase tracking-widest">
        Presencia & Cobertura Global
      </span>

      <h2 class="font-sora text-3xl sm:text-4xl lg:text-[40px] font-extrabold tracking-tight text-white leading-[1.2] uppercase">
        Desde Colombia y Estados Unidos,<br class="hidden sm:inline" />
        trabajando con empresas sin fronteras.
      </h2>

      <p class="font-inter-tight text-sm sm:text-base md:text-lg text-white/70 max-w-3xl mx-auto leading-relaxed">
        Combinamos talento de alto nivel, visión estratégica y ejecución tecnológica para colaborar con compañías en múltiples industrias y horarios.
      </p>

    </div>
  </div>
</section>
