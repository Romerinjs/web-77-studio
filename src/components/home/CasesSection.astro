---
// src/components/home/CasesSection.astro
const cases = [
  {
    category: "Marketing & Ads",
    client: "E-Commerce & Retail B2B",
    title: "Escalamiento de Adquisición con Meta Ads & Creativos Dinámicos",
    challenge: "Costo por lead elevado y fatiga publicitaria en campañas de captación.",
    solution: "Estructuración de audiencias segmentadas, nuevos ángulos de copy y producción ágil de creativos en video.",
    result: "+185% Leads Calificados · -42% Costo por Adquisición",
    tag: "Marketing"
  },
  {
    category: "Desarrollo Web Astro",
    client: "Firma de Consultoría & Finanzas",
    title: "Rediseño de Plataforma Web enfocada en Conversión & CRO",
    challenge: "Sitio web lento en WordPress con tasa de rebote del 70% y baja captación de clientes corporativos.",
    solution: "Migración a Astro 5 con Islands Architecture, doble CTA comercial (WhatsApp + Form) y optimización de velocidad.",
    result: "Velocidad 99/100 · +120% Incremento en Contactos Directos",
    tag: "Web"
  },
  {
    category: "IA & Automatización",
    client: "Empresa de Servicios Profesionales",
    title: "Automatización de Seguimiento Comercial 24/7 con Agente de IA",
    challenge: "Pérdida de prospectos nocturnos y fines de semana por falta de respuesta inmediata en WhatsApp.",
    solution: "Implementación de flujo automatizado con n8n y agente inteligente RAG para calificación y agendamiento en CRM.",
    result: "< 30s Tiempo de Respuesta · 100% Leads Atendidos al Instante",
    tag: "IA"
  },
  {
    category: "Productos Digitales",
    client: "Startup de Logística",
    title: "Desarrollo de MVP y Dashboard de Operaciones en Tiempo Real",
    challenge: "Gestión operativa manual mediante hojas de cálculo desconectadas.",
    solution: "Construcción de portal web y dashboard reactivo para visualización de métricas y control de despachos.",
    result: "Lanzamiento en 4 Semanas · Reducción de 15h semanales en reportes",
    tag: "SaaS"
  }
];
---

<section id="casos" class="py-20 sm:py-28 bg-white border-t border-black/5">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-slate-50 px-3.5 py-1 font-ibm-plex-mono text-xs text-opai-purple mb-4">
        <span>CASOS DE NEGOCIO & RESULTADOS</span>
      </div>
      <h2 class="font-sora text-3xl sm:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-5">
        Proyectos reales diseñados para mover métricas comerciales.
      </h2>
      <p class="font-inter-tight text-base sm:text-lg text-background-13/70 leading-relaxed">
        Sin métricas infladas ni promesas vacías. Así es como resolvemos problemas concretos de crecimiento y eficiencia para empresas reales.
      </p>
    </div>

    <!-- Case Studies Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-14">
      {cases.map((cs) => (
        <div class="rounded-[24px] border border-black/10 bg-slate-50 p-8 shadow-xs card-hover flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-ibm-plex-mono text-xs font-semibold text-opai-purple bg-white px-3 py-1 rounded-lg border border-black/5">
                {cs.category}
              </span>
              <span class="font-ibm-plex-mono text-xs text-background-13/50">
                {cs.client}
              </span>
            </div>

            <h3 class="font-sora text-xl sm:text-2xl font-bold text-background-13 mb-4">
              {cs.title}
            </h3>

            <div class="space-y-3 mb-6 font-inter-tight text-sm text-background-13/75">
              <div>
                <strong class="text-background-13 font-semibold">El Reto: </strong>
                <span>{cs.challenge}</span>
              </div>
              <div>
                <strong class="text-background-13 font-semibold">Nuestra Solución: </strong>
                <span>{cs.solution}</span>
              </div>
            </div>
          </div>

          <!-- Highlight Result Badge -->
          <div class="rounded-xl border border-emerald-500/20 bg-emerald-50/70 p-3.5 flex items-center gap-2.5">
            <span class="text-emerald-600 font-bold text-base">📈</span>
            <span class="font-ibm-plex-mono text-xs font-semibold text-emerald-800">
              {cs.result}
            </span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
