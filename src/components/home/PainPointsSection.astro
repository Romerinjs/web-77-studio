---
// src/components/home/PainPointsSection.astro
import DualCTA from '@/components/DualCTA.astro';
import { getHomeTranslations } from '@/lib/i18n/pages/home';
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const t = getHomeTranslations(currentLang);
---

<section class="py-20 sm:py-28 bg-slate-50 relative" aria-labelledby="reto-heading">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header (Centered) -->
    <div class="max-w-3xl mb-14 mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-3.5 py-1 font-ibm-plex-mono text-xs text-opai-purple">
        <span>{t.painPoints.badge}</span>
      </div>
      <h2 id="reto-heading" data-text-reveal class="font-sora text-3xl sm:text-5xl font-bold tracking-tight text-background-13 leading-tight">
        {t.painPoints.title}
      </h2>
      <p data-opai-animate data-delay="0.2" class="font-inter-tight text-base sm:text-lg text-background-13/70">
        {t.painPoints.subtitle}
      </p>
    </div>

    <!-- 5 Pain Points Editorial Grid (Image 3 inspired layout and cards distribution) -->
    <div
      class="grid grid-cols-12 items-center justify-center gap-4 *:col-span-12 md:*:col-span-6 lg:gap-2 lg:*:col-start-auto md:[&>*:last-child]:col-span-12 lg:[&>*:nth-child(5n+1)]:col-span-4 lg:[&>*:nth-child(5n+2)]:col-span-4 lg:[&>*:nth-child(5n+3)]:col-span-4 lg:[&>*:nth-child(5n+4)]:col-span-6 lg:[&>*:nth-child(5n+5)]:col-span-6 mb-14"
      role="list"
      aria-label="Fricciones de crecimiento"
    >
      {t.painPoints.items.map((point, index) => (
        <div
          data-opai-animate
          data-delay={(index + 1) * 0.1}
          role="listitem"
        >
          <a href="#contacto" class="block group">
            <div
              class="flex h-[300px] flex-col items-start justify-between rounded-3xl bg-white p-8 lg:h-[370px] xl:p-14 border border-stroke-2/60 hover:shadow-lg transition-all duration-300 card-hover"
              aria-label={point.title}
            >
              <span
                class="bg-background-3 flex size-17 items-center justify-center rounded-3xl p-4 transition-transform duration-300 group-hover:scale-105"
                aria-hidden="true"
              >
                {index === 0 && (
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                    <circle cx="12" cy="12" r="10" stroke-dasharray="2 2" />
                    <path d="M12 2v20M2 12h20" />
                    <ellipse cx="12" cy="12" rx="6" ry="10" />
                    <ellipse cx="12" cy="12" rx="10" ry="4" />
                  </svg>
                )}
                {index === 1 && (
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                    <path d="M4 12h16M12 4v16" stroke-dasharray="1 3" />
                    <circle cx="12" cy="4" r="3" />
                    <circle cx="12" cy="20" r="3" />
                    <circle cx="4" cy="12" r="3" />
                    <circle cx="20" cy="12" r="3" />
                    <path d="M6.5 6.5l11 11M6.5 17.5l11-11" />
                  </svg>
                )}
                {index === 2 && (
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                    <circle cx="12" cy="12" r="9" />
                    <circle cx="12" cy="12" r="6" />
                    <circle cx="12" cy="12" r="3" />
                    <path d="M12 2v4M12 18v4M2 12h4M18 12h4" />
                  </svg>
                )}
                {index === 3 && (
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                    <path d="M12 16v-8M8 12h8" />
                    <circle cx="12" cy="4" r="2" />
                    <circle cx="12" cy="20" r="2" />
                    <circle cx="4" cy="12" r="2" />
                    <circle cx="20" cy="12" r="2" />
                    <path d="M6 6l12 12M6 18l12-12" />
                  </svg>
                )}
                {index === 4 && (
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                    <rect x="3" y="3" width="7" height="7" rx="1" />
                    <rect x="14" y="3" width="7" height="7" rx="1" />
                    <rect x="3" y="14" width="7" height="7" rx="1" />
                    <rect x="14" y="14" width="7" height="7" rx="1" stroke-dasharray="2 2" />
                    <path d="M10 6.5h4M6.5 10v4M14 17.5h-4" stroke-dasharray="2 2" />
                  </svg>
                )}
              </span>

              <div class="space-y-2.5">
                <h3 class="font-sora text-xl font-semibold text-background-13 group-hover:text-opai-purple transition-colors">
                  {point.title}
                </h3>
                <p class="font-inter-tight text-sm text-background-13/70 leading-relaxed max-w-[270px]">
                  {'desc' in point ? point.desc : (point as any).description}
                </p>
              </div>
            </div>
          </a>
        </div>
      ))}
    </div>

    <!-- Section CTA Block -->
    <div data-opai-animate data-delay="0.6" class="rounded-2xl border border-black/10 bg-white p-8 text-center max-w-3xl mx-auto shadow-sm">
      <h3 class="font-sora text-xl sm:text-2xl font-bold text-background-13 mb-3">
        {currentLang === 'en' 
          ? "Do any of these challenges sound familiar?"
          : "¿Te identificas con alguno de estos puntos en tu empresa?"}
      </h3>
      <p class="font-inter-tight text-sm sm:text-base text-background-13/70 mb-6 max-w-xl mx-auto">
        {currentLang === 'en'
          ? "Let's talk directly. We'll analyze your current setup and provide straightforward guidance with zero obligations."
          : "Conversemos directamente. Analizamos tu situación actual y te orientamos sin compromisos sobre el mejor camino."}
      </p>
      <DualCTA
        whatsappContext="home"
        whatsappText={currentLang === 'en' ? "Tell us what you want to improve" : "Cuéntanos qué quieres mejorar"}
        emailText={currentLang === 'en' ? "Contact via email" : "Escribirnos por email"}
        emailHref="#contacto"
        lang={currentLang}
      />
    </div>

  </div>
</section>
