---
// src/components/home/PainPointsSection.astro
import DualCTA from '@/components/DualCTA.astro';

const painPoints = [
  {
    number: "01",
    title: "Presencia digital débil",
    description: "Tu marca o sitio web actual no refleja la verdadera calidad, autoridad y nivel de servicio de tu empresa ante clientes potenciales.",
    tag: "Diseño & Autoridad"
  },
  {
    number: "02",
    title: "Contenido sin sistema",
    description: "Sabes que necesitas producir piezas, video y publicaciones de forma constante, pero tu equipo no tiene el tiempo ni el flujo operativo estructurado.",
    tag: "Marketing & Creación"
  },
  {
    number: "03",
    title: "Oportunidades que se pierden",
    description: "Inviertes en anuncios o tráfico, pero los leads tardan horas en recibir respuesta o se quedan sin seguimiento comercial oportuno.",
    tag: "Ventas & Conversión"
  },
  {
    number: "04",
    title: "IA sin dirección práctica",
    description: "Escuchas sobre herramientas de inteligencia artificial a diario, pero nadie te muestra aplicaciones concretas que ahorren costos o aumenten ventas.",
    tag: "Tecnología Aplicada"
  },
  {
    number: "05",
    title: "Demasiados proveedores desconectados",
    description: "Una agencia para pauta, un freelancer para la web, otro para contenido y nadie asume la responsabilidad del resultado global del negocio.",
    tag: "Gestión Fragmentada"
  }
];
---

<section class="py-20 sm:py-28 bg-slate-50 relative">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-14">
      <div class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-3.5 py-1 font-ibm-plex-mono text-xs text-opai-purple mb-4">
        <span>EL RETO DIGITAL</span>
      </div>
      <h2 class="font-sora text-3xl sm:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-5">
        Tu empresa está creciendo. Pero lo digital sigue demasiado fragmentado.
      </h2>
      <p class="font-inter-tight text-base sm:text-lg text-background-13/70 leading-relaxed">
        Marketing por un lado. La web con otro proveedor. El contenido nunca está listo. Los leads llegan y nadie los sigue. Y mientras tanto, todo el mundo habla de IA sin explicar realmente cómo puede ayudarte.
      </p>
    </div>

    <!-- 5 Pain Points Editorial Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-14">
      {painPoints.map((point, index) => (
        <div class={`rounded-[20px] border border-black/10 bg-white p-7 shadow-xs card-hover flex flex-col justify-between ${index === 4 ? 'md:col-span-2 lg:col-span-1' : ''}`}>
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-ibm-plex-mono text-sm font-bold text-opai-purple bg-opai-purple/10 px-2.5 py-1 rounded-lg">
                {point.number}
              </span>
              <span class="font-ibm-plex-mono text-[11px] text-background-13/50 uppercase tracking-wider">
                {point.tag}
              </span>
            </div>
            
            <h3 class="font-sora text-xl font-semibold text-background-13 mb-2.5">
              {point.title}
            </h3>
            
            <p class="font-inter-tight text-sm text-background-13/70 leading-relaxed">
              {point.description}
            </p>
          </div>

          <div class="pt-6 border-t border-black/5 mt-6 flex items-center gap-2 text-xs font-ibm-plex-mono text-opai-purple font-medium">
            <span>Diagnóstico disponible</span>
            <span>→</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Section CTA Block -->
    <div class="rounded-2xl border border-black/10 bg-white p-8 text-center max-w-3xl mx-auto shadow-sm">
      <h3 class="font-sora text-xl sm:text-2xl font-bold text-background-13 mb-3">
        ¿Te identificas con alguno de estos puntos en tu empresa?
      </h3>
      <p class="font-inter-tight text-sm sm:text-base text-background-13/70 mb-6 max-w-xl mx-auto">
        Conversemos directamente. Analizamos tu situación actual y te orientamos sin compromisos sobre el mejor camino.
      </p>
      <DualCTA
        whatsappContext="home"
        whatsappText="Cuéntanos qué quieres mejorar"
        emailText="Escribirnos por email"
        emailHref="#contacto"
      />
    </div>

  </div>
</section>
