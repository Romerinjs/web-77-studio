        <div class="card-aura-bg" style="background-image: url('/img/header/Grainy_Gradient_Background_high_resolution_preview_2222917.jpg')"></div>
        <div class="metric-card-content flex flex-col items-center text-center space-y-2.5">
          <span class="font-sora text-4xl sm:text-5xl font-extrabold text-background-13 leading-none">+310%</span>
          <span class="font-sora text-base font-semibold text-background-13/90 leading-tight">Incremento en Leads Calificados</span>
          <span class="font-inter-tight text-xs text-background-13/60 leading-relaxed">Filtro de IA pre-califica antes de agendar</span>
        </div>
      </div>

      <!-- Metric 2 -->
      <div class="metric-card rounded-3xl bg-white p-8 sm:p-10 border border-black/5 shadow-[0_8px_30px_rgb(0,0,0,0.02)]">
        <!-- Background Grainy Gradient Aura -->
        <div class="card-aura-bg" style="background-image: url('/img/header/1000_F_226549800_JcTsSD70la5lDHAuo1MWRmBpECmJTH8d.jpg')"></div>
        <div class="metric-card-content flex flex-col items-center text-center space-y-2.5">
