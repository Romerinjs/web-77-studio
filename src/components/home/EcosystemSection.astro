---
// src/components/home/EcosystemSection.astro
const pillars = [
  {
    id: "marketing",
    name: "Marketing & Ads",
    subtitle: "Atracción & Autoridad",
    items: ["Estrategia integral", "Meta Ads & Google Ads", "Producción de contenido", "Branding comercial"],
    href: "/marketing",
    tag: "01",
    color: "border-purple-200 bg-purple-50/40"
  },
  {
    id: "web",
    name: "Web & Landings",
    subtitle: "Confianza & Conversión",
    items: ["Websites ultra veloces (Astro)", "Landing pages CRO", "Optimización de embudo", "Arquitectura de contenidos"],
    href: "/web",
    tag: "02",
    color: "border-blue-200 bg-blue-50/40"
  },
  {
    id: "ia",
    name: "IA + Automatización",
    subtitle: "Operación & Eficiencia",
    items: ["Integración CRM & Leads", "Workflows automáticos n8n/Make", "Agentes de atención y ventas", "Eliminación de tareas manuales"],
    href: "/ia-automatizacion",
    tag: "03",
    color: "border-emerald-200 bg-emerald-50/40"
  },
  {
    id: "productos",
    name: "Productos Digitales",
    subtitle: "Escala & Software",
    items: ["Desarrollo de SaaS & MVPs", "Portales para clientes", "Dashboards analíticos", "Herramientas a la medida"],
    href: "/productos-digitales",
    tag: "04",
    color: "border-amber-200 bg-amber-50/40"
  }
];
---

<section class="py-20 sm:py-28 bg-white border-t border-black/5 relative overflow-hidden">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-slate-50 px-3.5 py-1 font-ibm-plex-mono text-xs text-opai-purple mb-4">
        <span>UN SOLO PARTNER DIGITAL</span>
      </div>
      <h2 class="font-sora text-3xl sm:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-5">
        No necesitas más proveedores. Necesitas un partner que conecte todo.
      </h2>
      <p class="font-inter-tight text-base sm:text-lg text-background-13/70 leading-relaxed">
        Reunimos creatividad, marketing, desarrollo web e inteligencia artificial dentro de un mismo ecosistema para acompañar a tu empresa desde la estrategia hasta la ejecución operativa.
      </p>
    </div>

    <!-- Node Connection Diagram (Central Hub + 4 Pillars) -->
    <div class="relative max-w-5xl mx-auto">
      
      <!-- Central Brand Core -->
      <div class="mb-10 flex justify-center">
        <div class="rounded-2xl border-2 border-opai-purple bg-white p-6 shadow-[0_10px_30px_rgba(124,58,237,0.15)] text-center max-w-md w-full relative z-10">
          <div class="h-10 w-10 mx-auto rounded-xl bg-background-13 text-white flex items-center justify-center font-sora font-bold text-base mb-3 shadow-sm">
            77
          </div>
          <span class="font-ibm-plex-mono text-xs font-semibold text-opai-purple tracking-wider uppercase block">
            NÚCLEO ESTRATÉGICO
          </span>
          <h3 class="font-sora text-xl font-bold text-background-13">77 Studio Ecosistema</h3>
          <p class="font-inter-tight text-xs text-background-13/70 mt-1">
            Coordinación unificada de marca, tecnología y ventas
          </p>
        </div>
      </div>

      <!-- 4 Connected Pillar Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {pillars.map((pillar) => (
          <div class={`rounded-[20px] border ${pillar.color} p-7 shadow-xs card-hover flex flex-col justify-between`}>
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-ibm-plex-mono text-xs font-bold text-background-13/80 bg-white px-2.5 py-1 rounded-md border border-black/5">
                  CAPACIDAD {pillar.tag}
                </span>
                <span class="font-ibm-plex-mono text-xs text-background-13/50">
                  {pillar.subtitle}
                </span>
              </div>

              <h4 class="font-sora text-2xl font-bold text-background-13 mb-3">
                {pillar.name}
              </h4>

              <ul class="space-y-2 mb-6">
                {pillar.items.map((item) => (
                  <li class="flex items-center gap-2 text-sm text-background-13/80 font-inter-tight">
                    <span class="h-1.5 w-1.5 rounded-full bg-opai-purple"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href={pillar.href}
              class="inline-flex items-center gap-2 font-ibm-plex-mono text-xs font-semibold text-opai-purple hover:text-background-13 pt-4 border-t border-black/5 transition-colors"
            >
              <span>Explorar capacidad {pillar.name}</span>
              <span>→</span>
            </a>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>
