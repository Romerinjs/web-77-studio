---
// src/components/Footer.astro
import { uiTranslations, type SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const t = uiTranslations[currentLang];
const currentYear = new Date().getFullYear();
const homeUrl = currentLang === 'en' ? '/en' : '/';
---

<footer class="border-t border-black/10 bg-white pt-16 pb-24 sm:pb-12 text-background-13">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-black/10">
      
      <!-- Brand column (2 cols wide on LG) -->
      <div class="lg:col-span-2 space-y-4">
        <a href={homeUrl} class="flex items-center gap-2.5">
          <div class="h-8 w-8 rounded-lg bg-background-13 flex items-center justify-center text-white font-sora font-bold text-sm tracking-tighter">
            77
          </div>
          <span class="font-sora font-semibold text-lg tracking-tight text-background-13">
            77 STUDIO
          </span>
        </a>
        
        <p class="font-inter-tight text-background-13/70 text-sm max-w-sm leading-relaxed">
          {t.footer.tagline}
        </p>
      </div>

      <!-- Servicios -->
      <div>
        <h4 class="font-sora font-semibold text-sm text-background-13 tracking-tight mb-4">
          {t.footer.servicesHeading}
        </h4>
        <ul class="space-y-2.5 text-sm text-background-13/70">
          {t.footer.serviceLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-background-13 hover:translate-x-1 inline-block transition-transform">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Empresa -->
      <div>
        <h4 class="font-sora font-semibold text-sm text-background-13 tracking-tight mb-4">
          {t.footer.companyHeading}
        </h4>
        <ul class="space-y-2.5 text-sm text-background-13/70">
          {t.footer.companyLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-background-13 hover:translate-x-1 inline-block transition-transform">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Presencia Internacional -->
      <div>
        <h4 class="font-sora font-semibold text-sm text-background-13 tracking-tight mb-4">
          {currentLang === 'en' ? 'Offices & Reach' : 'Sedes & Cobertura'}
        </h4>
        <div class="space-y-3 text-sm text-background-13/70">
          <div class="rounded-xl border border-black/5 bg-slate-50 p-3">
            <span class="font-semibold block text-background-13 text-xs font-ibm-plex-mono">COLOMBIA</span>
            <span class="text-xs text-background-13/60">Medellín / Bogotá · LatAm Hub</span>
          </div>
          <div class="rounded-xl border border-black/5 bg-slate-50 p-3">
            <span class="font-semibold block text-background-13 text-xs font-ibm-plex-mono">UNITED STATES</span>
            <span class="text-xs text-background-13/60">Miami, FL · North America & Global</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom copyright row -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-inter-tight text-background-13/50">
      <p>© {currentYear} 77 Studio. {t.footer.rights}</p>
      
      <div class="flex items-center gap-6 font-ibm-plex-mono text-xs text-background-13/60">
        <span>{t.footer.presence}</span>
      </div>
    </div>
  </div>
</footer>
