---
// src/components/nosotros/EvolutionTimeline.astro
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const isEn = currentLang === 'en';

const stages = [
  {
    number: "01",
    title: isEn ? "Creative Roots & Brand Direction" : "Raíz Creativa & Dirección de Marca",
    description: isEn
      ? "We started with a non-negotiable visual standard: identity design, art direction, and cinematic assets built with tier-one aesthetic rigor."
      : "Nacimos con un estándar visual innegociable: diseño de identidad, dirección de arte y piezas audiovisuales con criterio estético de primer nivel."
  },
  {
    number: "02",
    title: isEn ? "Paid Media & Growth Performance" : "Paid Media & Performance Marketing",
    description: isEn
      ? "We bridged creative excellence with paid acquisition on Meta and Google Ads, turning premium branding into verifiable pipeline revenue."
      : "Conectamos la creatividad con la adquisición en Meta Ads y Google Ads para que el buen diseño se traduzera en clientes reales y ventas para las empresas."
  },
  {
    number: "03",
    title: isEn ? "High-Converting Web Engineering" : "Ingeniería Web de Alta Conversión",
    description: isEn
      ? "We left slow legacy website builders behind to engineer in Astro & Tailwind: ultra-fast digital sales architectures with calibrated dual CTAs."
      : "Dejamos atrás plataformas lentas para desarrollar en Astro y Tailwind: páginas ultra-rápidas estructuradas como cartas de venta digitales y doble CTA."
  },
  {
    number: "04",
    title: isEn ? "Automation, AI & Product Studio" : "Automatización, IA & Product Studio",
    description: isEn
      ? "Today we integrate automated CRM workflows, zero-fluff AI agents, and bespoke digital software (SaaS, portals, and dashboards) under one strategic partner."
      : "Hoy integramos flujos de CRM automáticos, agentes de IA sin clichés y software a la medida (SaaS, portales y dashboards) dentro de un solo partner digital."
  }
];
---

<section class="py-20 sm:py-28 bg-white border-t border-black/5 relative">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header (Centered) -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 data-text-reveal class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
        {isEn ? "More than an agency. A continuous evolution." : "Más que una agencia. Una evolución continua."}
      </h2>
      <p data-opai-animate data-delay="0.2" class="font-inter-tight text-base sm:text-lg text-background-13/75 leading-relaxed max-w-2xl mx-auto">
        {isEn
          ? "We evolved directly alongside our clients' real commercial needs. We grew from creative design into comprehensive technological and automation execution."
          : "Evolucionamos junto con las necesidades reales de nuestros clientes. Crecimos desde el diseño creativo hacia capacidades tecnológicas y de automatización integrales."}
      </p>
    </div>

    <!-- 4 Stages Timeline Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {stages.map((st, index) => (
        <div 
          data-opai-animate
          data-delay={(0.1 * (index + 1)).toFixed(1)}
          class="group rounded-[24px] border border-stroke-2/60 border-b-2 border-b-transparent bg-slate-50/70 p-7 sm:p-8 flex flex-col justify-start transition-all duration-300 hover:bg-white hover:shadow-md hover:border-black/20 hover:border-b-opai-purple"
        >
          <div class="flex items-center justify-between mb-5">
            <span class="font-ibm-plex-mono text-2xl sm:text-3xl font-bold text-opai-purple group-hover:scale-105 transition-transform">
              {st.number}
            </span>
          </div>

          <h3 class="font-sora text-lg sm:text-xl font-bold text-background-13 mb-3 group-hover:text-opai-purple transition-colors leading-snug">
            {st.title}
          </h3>

          <p class="font-inter-tight text-xs sm:text-sm text-background-13/75 leading-relaxed">
            {st.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
