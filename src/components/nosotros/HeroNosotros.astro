---
// src/components/nosotros/HeroNosotros.astro
import DualCTA from '@/components/DualCTA.astro';
import { Users, Globe2, Sparkles, Code2, Zap, ArrowRight, ShieldCheck } from 'lucide-astro';
---

<section class="relative pt-36 pb-16 sm:pt-44 sm:pb-24 overflow-hidden">
  <!-- Ambient Glow -->
  <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center opacity-60">
    <div class="h-[520px] w-[520px] rounded-full bg-gradient-to-tr from-opai-purple/15 to-transparent blur-[130px]"></div>
    <div class="h-[420px] w-[420px] rounded-full bg-gradient-to-bl from-blue-500/10 to-transparent blur-[110px] -translate-y-20"></div>
  </div>

  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    <div class="text-center max-w-4xl mx-auto">
      
      <!-- Top Pill Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white/90 px-4 py-1.5 backdrop-blur-md shadow-xs mb-6">
        <span class="h-2 w-2 rounded-full bg-opai-purple animate-pulse"></span>
        <span class="font-ibm-plex-mono text-xs font-medium tracking-wide text-background-13/80 uppercase">
          Módulo 06 · Digital Studio · Colombia ↔ USA
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-sora text-4xl sm:text-6xl lg:text-[62px] font-bold tracking-tight text-background-13 leading-[1.12] mb-6">
        Un equipo creativo y tecnológico construido para <span class="bg-gradient-to-r from-background-13 via-opai-purple to-background-13 bg-clip-text text-transparent">resolver retos digitales</span>.
      </h1>

      <!-- Subheadline -->
      <p class="font-inter-tight text-lg sm:text-xl text-background-13/75 max-w-3xl mx-auto mb-9 leading-relaxed">
        SOMOS 77 STUDIO: Un solo equipo multidisciplinario que reúne estrategia, Paid Media, diseño, ingeniería web, automatización e inteligencia artificial. Sin burocracia de agencia tradicional ni silos desconectados.
      </p>

      <!-- Dual Commercial CTA (WhatsApp nosotros context + Contact form) -->
      <div class="mb-12">
        <DualCTA
          whatsappContext="nosotros"
          whatsappText="Hablar con el equipo fundador"
          emailText="Escribirnos por email"
          emailHref="#contacto"
          centered={true}
        />
      </div>

      <!-- Trust Pillars -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-y-3 gap-x-8 text-xs font-ibm-plex-mono text-background-13/60 border-t border-black/5">
        <div class="flex items-center gap-2">
          <span class="text-emerald-500 font-bold">✓</span>
          <span>Operación Remota Colombia ↔ USA</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-500 font-bold">✓</span>
          <span>Interlocución Directa con Especialistas</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-500 font-bold">✓</span>
          <span>Enfoque en Métricas de Negocio Reales</span>
        </div>
      </div>

    </div>

    <!-- Studio Showcase Composition (Team & Operating Model Hub) -->
    <div class="mt-14 relative mx-auto max-w-5xl">
      <div class="relative rounded-[28px] border border-black/10 bg-white p-4 sm:p-7 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.08)] backdrop-blur-xl">
        
        <!-- Showcase Top Bar -->
        <div class="flex items-center justify-between border-b border-black/5 pb-4 px-2">
          <div class="flex items-center gap-3">
            <div class="h-8 w-8 rounded-lg bg-background-13 text-white flex items-center justify-center font-sora font-bold text-xs">
              77
            </div>
            <div>
              <span class="font-sora text-sm font-bold text-background-13 block">77 Studio Operating System</span>
              <span class="font-ibm-plex-mono text-[10px] text-background-13/50">Cultura de Alto Rendimiento · LatAm & North America</span>
            </div>
          </div>
          <div class="flex items-center gap-2 font-ibm-plex-mono text-xs">
            <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-ping"></span>
            <span class="text-background-13/80 font-semibold">Equipo Activo</span>
          </div>
        </div>

        <!-- 3 Core Operational Hubs -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-5">
          
          <!-- Hub 1: Estrategia & Creatividad -->
          <div class="rounded-2xl border border-black/5 bg-slate-50 p-5 text-left">
            <div class="flex items-center justify-between mb-3">
              <span class="font-ibm-plex-mono text-xs font-bold text-opai-purple">01. CREATIVIDAD</span>
              <span class="text-xs px-2 py-0.5 rounded-full bg-purple-100 text-purple-800 font-medium">Marca & Ads</span>
            </div>
            <h3 class="font-sora text-base font-bold text-background-13 mb-1">Estrategia & Contenido</h3>
            <p class="font-inter-tight text-xs text-background-13/70 mb-4 leading-relaxed">
              Dirección de arte, producción audiovisual, copywriting persuasivo y campañas publicitarias en Meta y Google.
            </p>
            <div class="pt-3 border-t border-black/5 font-ibm-plex-mono text-[11px] text-background-13/70 flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-opai-purple"></span>
              <span>Mensaje alineado a conversión</span>
            </div>
          </div>

          <!-- Hub 2: Ingeniería Web & Software -->
          <div class="rounded-2xl border border-black/5 bg-slate-50 p-5 text-left">
            <div class="flex items-center justify-between mb-3">
              <span class="font-ibm-plex-mono text-xs font-bold text-blue-600">02. TECNOLOGÍA</span>
              <span class="text-xs px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 font-medium">Web & Code</span>
            </div>
            <h3 class="font-sora text-base font-bold text-background-13 mb-1">Desarrollo Web & SaaS</h3>
            <p class="font-inter-tight text-xs text-background-13/70 mb-4 leading-relaxed">
              Arquitecturas modernas ultra veloces en Astro 5, TypeScript, portales de autogestión y dashboards a la medida.
            </p>
            <div class="pt-3 border-t border-black/5 font-ibm-plex-mono text-[11px] text-background-13/70 flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-blue-600"></span>
              <span>Cero código obsoleto ni plantillas</span>
            </div>
          </div>

          <!-- Hub 3: IA & Automatización -->
          <div class="rounded-2xl border border-black/5 bg-slate-50 p-5 text-left">
            <div class="flex items-center justify-between mb-3">
              <span class="font-ibm-plex-mono text-xs font-bold text-emerald-600">03. EFICIENCIA</span>
              <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-medium">Workflows</span>
            </div>
            <h3 class="font-sora text-base font-bold text-background-13 mb-1">Automatización & IA</h3>
            <p class="font-inter-tight text-xs text-background-13/70 mb-4 leading-relaxed">
              Integración de CRMs, secuencias de WhatsApp Business, agentes de atención 24/7 y eliminación de tareas manuales.
            </p>
            <div class="pt-3 border-t border-black/5 font-ibm-plex-mono text-[11px] text-background-13/70 flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
              <span>Operación continua sin fricción</span>
            </div>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>
