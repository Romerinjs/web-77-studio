---
// src/components/nosotros/GlobalPresenceSection.astro
import DualCTA from '@/components/DualCTA.astro';
---

<section class="py-20 sm:py-28 bg-slate-50 border-t border-black/5 relative">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-3.5 py-1 font-ibm-plex-mono text-xs text-opai-purple mb-4">
        <span>COBERTURA INTERNACIONAL</span>
      </div>
      <h2 class="font-sora text-3xl sm:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-5">
        Pensados para trabajar más allá de una ubicación.
      </h2>
      <p class="font-inter-tight text-base sm:text-lg text-background-13/70 leading-relaxed">
        Nuestra estructura remota e internacional conecta el mejor talento de Colombia con empresas en Estados Unidos, Latinoamérica y mercados globales.
      </p>
    </div>

    <!-- 2 Regional Hubs Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-14 max-w-4xl mx-auto">
      
      <!-- Colombia Hub -->
      <div class="rounded-[24px] border border-black/10 bg-white p-8 sm:p-10 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
              <span class="text-3xl">🇨🇴</span>
              <div>
                <span class="font-ibm-plex-mono text-xs font-bold text-opai-purple uppercase block">HUB LATINOAMÉRICA</span>
                <h3 class="font-sora text-2xl font-bold text-background-13">Colombia</h3>
              </div>
            </div>
            <span class="font-ibm-plex-mono text-xs text-background-13/50">GMT-5</span>
          </div>

          <p class="font-inter-tight text-sm text-background-13/75 leading-relaxed mb-6">
            Sede de nuestro equipo creativo, ingenieros de software, productores audiovisuales y especialistas en automatización e inteligencia artificial.
          </p>

          <div class="space-y-2 font-ibm-plex-mono text-xs text-background-13/80">
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Medellín & Bogotá · Operaciones & Desarrollo</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Talento de alto nivel con cultura de entrega ágil</span>
            </div>
          </div>
        </div>
      </div>

      <!-- United States Hub -->
      <div class="rounded-[24px] border border-black/10 bg-white p-8 sm:p-10 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
              <span class="text-3xl">🇺🇸</span>
              <div>
                <span class="font-ibm-plex-mono text-xs font-bold text-blue-600 uppercase block">HUB NORTEAMÉRICA</span>
                <h3 class="font-sora text-2xl font-bold text-background-13">United States</h3>
              </div>
            </div>
            <span class="font-ibm-plex-mono text-xs text-background-13/50">EST</span>
          </div>

          <p class="font-inter-tight text-sm text-background-13/75 leading-relaxed mb-6">
            Punto de conexión estratégica para clientes en Estados Unidos y proyectos de expansión internacional con comunicación bilingüe y estándares globales.
          </p>

          <div class="space-y-2 font-ibm-plex-mono text-xs text-background-13/80">
            <div class="flex items-center gap-2">
              <span class="text-blue-600 font-bold">✓</span>
              <span>Miami & Remote · Estrategia & Clientes Globales</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-blue-600 font-bold">✓</span>
              <span>Facturación internacional y contratos directos</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Conversion Box -->
    <div class="rounded-2xl border border-black/10 bg-white p-8 text-center max-w-3xl mx-auto shadow-xs">
      <h3 class="font-sora text-xl sm:text-2xl font-bold text-background-13 mb-3">
        ¿Quieres conocer cómo podemos colaborar con tu empresa?
      </h3>
      <p class="font-inter-tight text-sm sm:text-base text-background-13/70 mb-6 max-w-xl mx-auto">
        Trabajamos sin fronteras con equipos en diferentes industrias y husos horarios. Hablemos de tus planes.
      </p>
      <DualCTA
        whatsappContext="nosotros"
        whatsappText="Conocer cómo podemos trabajar juntos"
        emailText="Escribirnos por email"
        emailHref="#contacto"
      />
    </div>

  </div>
</section>
