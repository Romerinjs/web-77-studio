---
// src/components/nosotros/GlobalPresenceSection.astro
import DualCTA from '@/components/DualCTA.astro';
import { MapPin, Globe } from 'lucide-astro';
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const isEn = currentLang === 'en';
---

<section class="py-20 sm:py-28 bg-slate-50 border-t border-black/5 relative">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header (Centered) -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 data-text-reveal class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
        {isEn ? "Architected to operate beyond geographical borders." : "Pensados para trabajar más allá de una ubicación."}
      </h2>
      <p data-opai-animate data-delay="0.2" class="font-inter-tight text-base sm:text-lg text-background-13/75 leading-relaxed max-w-2xl mx-auto">
        {isEn
          ? "Our cross-border remote structure bridges tier-one technical talent in Colombia with enterprises in the United States, Latin America, and global markets."
          : "Nuestra estructura remota e internacional conecta el mejor talento de Colombia con empresas en Estados Unidos, Latinoamérica y mercados globales."}
      </p>
    </div>

    <!-- 2 Regional Hubs Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-14 max-w-4xl mx-auto">
      
      <!-- Colombia Hub -->
      <div data-opai-animate data-delay="0.1" class="group rounded-[28px] border border-stroke-2/60 border-b-2 border-b-transparent bg-white p-8 sm:p-10 shadow-xs hover:shadow-lg hover:border-black/20 hover:border-b-opai-purple transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3.5">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-background-13 text-white shadow-xs group-hover:scale-105 transition-transform">
                <Globe class="h-6 w-6 text-white" />
              </div>
              <div>
                <h3 class="font-sora text-2xl font-bold text-background-13 group-hover:text-opai-purple transition-colors">
                  Colombia
                </h3>
              </div>
            </div>
            <span class="font-ibm-plex-mono text-xs text-background-13/50 font-medium bg-black/5 px-2.5 py-1 rounded-lg">GMT-5</span>
          </div>

          <p class="font-inter-tight text-sm sm:text-base text-background-13/75 leading-relaxed mb-6">
            {isEn
              ? "Base of our creative studio, software engineers, video production units, and automation & AI architects."
              : "Sede de nuestro equipo creativo, ingenieros de software, productores audiovisuales y especialistas en automatización e inteligencia artificial."}
          </p>

          <div class="space-y-2.5 font-ibm-plex-mono text-xs text-background-13/80">
            <div class="flex items-center gap-2">
              <span class="size-1.5 rounded-full bg-emerald-500"></span>
              <span>{isEn ? "Medellín & Bogotá · Operations & Engineering Hub" : "Medellín & Bogotá · Operaciones & Desarrollo"}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="size-1.5 rounded-full bg-emerald-500"></span>
              <span>{isEn ? "Top-tier talent with an agile delivery mindset" : "Talento de alto nivel con cultura de entrega ágil"}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- United States Hub -->
      <div data-opai-animate data-delay="0.2" class="group rounded-[28px] border border-stroke-2/60 border-b-2 border-b-transparent bg-white p-8 sm:p-10 shadow-xs hover:shadow-lg hover:border-black/20 hover:border-b-opai-purple transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3.5">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-background-13 text-white shadow-xs group-hover:scale-105 transition-transform">
                <MapPin class="h-6 w-6 text-white" />
              </div>
              <div>
                <h3 class="font-sora text-2xl font-bold text-background-13 group-hover:text-opai-purple transition-colors">
                  United States
                </h3>
              </div>
            </div>
            <span class="font-ibm-plex-mono text-xs text-background-13/50 font-medium bg-black/5 px-2.5 py-1 rounded-lg">EST</span>
          </div>

          <p class="font-inter-tight text-sm sm:text-base text-background-13/75 leading-relaxed mb-6">
            {isEn
              ? "Strategic touchpoint for US-based clients and international expansion projects with native bilingual execution and global standards."
              : "Punto de conexión estratégica para clientes en Estados Unidos y proyectos de expansión internacional con comunicación bilingüe y estándares globales."}
          </p>

          <div class="space-y-2.5 font-ibm-plex-mono text-xs text-background-13/80">
            <div class="flex items-center gap-2">
              <span class="size-1.5 rounded-full bg-blue-600"></span>
              <span>{isEn ? "Miami & Remote · Strategy & Global Accounts" : "Miami & Remote · Estrategia & Clientes Globales"}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="size-1.5 rounded-full bg-blue-600"></span>
              <span>{isEn ? "International invoicing & direct contracts" : "Facturación internacional y contratos directos"}</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Conversion Box -->
    <div class="rounded-2xl border border-black/10 bg-white p-8 text-center max-w-3xl mx-auto shadow-xs">
      <h3 class="font-sora text-xl sm:text-2xl font-bold text-background-13 mb-3">
        {isEn
          ? "Want to see how we can partner with your enterprise?"
          : "¿Quieres conocer cómo podemos colaborar con tu empresa?"}
      </h3>
      <p class="font-inter-tight text-sm sm:text-base text-background-13/70 mb-6 max-w-xl mx-auto">
        {isEn
          ? "We operate seamlessly across industries and time zones. Let's discuss your roadmap."
          : "Trabajamos sin fronteras con equipos en diferentes industrias y husos horarios. Hablemos de tus planes."}
      </p>
      <DualCTA
        whatsappContext="nosotros"
        whatsappText={isEn ? "Discover how we can collaborate" : "Conocer cómo podemos trabajar juntos"}
        emailText={isEn ? "Write to us via email" : "Escribirnos por email"}
        emailHref="#contacto"
        centered={true}
        lang={currentLang}
      />
    </div>

  </div>
</section>
