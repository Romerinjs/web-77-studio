---
// src/components/nosotros/PhilosophySection.astro
import { ShieldCheck, Sparkles, Zap, Lock } from 'lucide-astro';

const principles = [
  {
    icon: ShieldCheck,
    title: "Cero Humo Tecnológico",
    description: "No recomendamos inteligencia artificial, software a medida o campañas complejas solo porque estén de moda. Proponemos únicamente lo que genera retorno comprobado."
  },
  {
    icon: Sparkles,
    title: "Creatividad + Código en la Misma Mesa",
    description: "Eliminamos la desconexión típica entre el equipo de diseño y el equipo de desarrollo. La estética y la funcionalidad se construyen juntas desde el día uno."
  },
  {
    icon: Zap,
    title: "Obsesión por la Ejecución Ágil",
    description: "Reemplazamos reuniones eternas y documentos burocráticos por entregables funcionales, sprints cortos y mejoras continuas sobre datos reales de uso."
  },
  {
    icon: Lock,
    title: "Propiedad Total para el Cliente",
    description: "Tus cuentas de Meta, Google, accesos de hosting, código fuente y bases de datos son 100% de tu empresa. Creemos en relaciones por valor, no por retención forzada."
  }
];
---

<section class="py-20 sm:py-28 bg-slate-50 border-t border-black/5 relative">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header (Centered) -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 data-text-reveal class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
        La tecnología cambia. Nuestro enfoque sigue siendo resolver problemas.
      </h2>
      <p data-opai-animate data-delay="0.2" class="font-inter-tight text-base sm:text-lg text-background-13/75 leading-relaxed max-w-2xl mx-auto">
        El objetivo no es acumular herramientas ni inflar métricas vanidosas. Es hacer que tu empresa se vea mejor, venda mejor y funcione mejor.
      </p>
    </div>

    <!-- 4 Principles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {principles.map((pr, index) => {
        const IconComponent = pr.icon;
        return (
          <div 
            data-opai-animate
            data-delay={(0.1 * (index + 1)).toFixed(1)}
            class="group rounded-[24px] border border-stroke-2/60 border-b-2 border-b-transparent bg-white p-7 sm:p-9 shadow-xs hover:shadow-lg hover:border-black/20 hover:border-b-opai-purple transition-all duration-300 flex flex-col justify-between"
          >
            <div>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-background-13 text-white mb-6 group-hover:scale-105 transition-transform shadow-xs">
                <IconComponent class="h-6 w-6 text-white" />
              </div>

              <h3 class="font-sora text-xl sm:text-2xl font-bold text-background-13 mb-3 group-hover:text-opai-purple transition-colors">
                {pr.title}
              </h3>

              <p class="font-inter-tight text-sm sm:text-base text-background-13/75 leading-relaxed">
                {pr.description}
              </p>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
