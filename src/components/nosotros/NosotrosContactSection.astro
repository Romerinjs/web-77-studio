---
// src/components/nosotros/NosotrosContactSection.astro
import ContactForm from '@/components/ContactForm.astro';
import { getWhatsAppUrl } from '@/utils/whatsapp';
import { Users, Sparkles, CheckCircle2 } from 'lucide-astro';

const whatsappUrl = getWhatsAppUrl('nosotros');
---

<section id="contacto" class="py-20 sm:py-28 bg-white relative overflow-hidden border-t border-black/5">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Direct WhatsApp & Info -->
      <div class="lg:col-span-5 space-y-8">
        
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-slate-50 px-3.5 py-1 font-ibm-plex-mono text-xs text-opai-purple mb-4">
            <span>CONVERSACIÓN DIRECTA</span>
          </div>
          <h2 class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
            Si buscas un equipo que entienda el negocio, hablemos.
          </h2>
          <p class="font-inter-tight text-base text-background-13/75 leading-relaxed">
            Sin rodeos ni intermediarios comerciales. Conéctate directamente con nuestro equipo para evaluar cómo podemos sumar a tu empresa en marketing, web, automatización o software.
          </p>
        </div>

        <!-- Direct WhatsApp Card -->
        <div class="rounded-[24px] border border-opai-purple/30 bg-slate-50 p-7 shadow-[0_10px_30px_rgba(124,58,237,0.08)]">
          <div class="flex items-center gap-3 mb-4">
            <div class="h-10 w-10 rounded-xl bg-opai-purple text-white flex items-center justify-center shadow-xs font-bold text-lg">
              👋
            </div>
            <div>
              <span class="font-sora font-bold text-base text-background-13 block leading-tight">
                Contacto Directo con Founders
              </span>
              <span class="font-ibm-plex-mono text-xs text-opai-purple font-medium">
                Respuesta en WhatsApp Business
              </span>
            </div>
          </div>

          <p class="font-inter-tight text-xs sm:text-sm text-background-13/70 mb-5 leading-relaxed">
            Escríbenos directamente para conversar sobre tu empresa, dudas técnicas o posibilidades de colaboración.
          </p>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center gap-2 bg-opai-purple hover:bg-opai-purple-hover text-white py-3 px-5 rounded-xl font-ibm-plex-mono text-sm font-semibold transition-all shadow-md active:scale-98"
          >
            <span>Conversar por WhatsApp</span>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <!-- Working Model Guarantees -->
        <div class="space-y-3 font-ibm-plex-mono text-xs text-background-13/60">
          <div class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>Trato directo con especialistas, no ejecutivos de cuentas</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>Respuesta en menos de 2 horas hábiles</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-500 font-bold">✓</span>
            <span>Operación: Colombia (GMT-5) · USA (EST)</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Lead Form -->
      <div class="lg:col-span-7">
        <ContactForm originPage="nosotros" />
      </div>

    </div>

  </div>
</section>
