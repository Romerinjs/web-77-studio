---
// src/components/web/HeroWeb.astro
import DualCTA from '@/components/DualCTA.astro';
import { Gauge, Smartphone, Zap, ShieldCheck, CheckCircle2, Code2, Globe } from 'lucide-astro';
---

<section class="relative pt-36 pb-16 sm:pt-44 sm:pb-24 overflow-hidden">
  <!-- Ambient Gradient Glow -->
  <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center opacity-60">
    <div class="h-[520px] w-[520px] rounded-full bg-gradient-to-tr from-blue-500/15 to-transparent blur-[130px]"></div>
    <div class="h-[420px] w-[420px] rounded-full bg-gradient-to-bl from-opai-purple/10 to-transparent blur-[110px] -translate-y-20"></div>
  </div>

  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    <div class="text-center max-w-4xl mx-auto">
      
      <!-- Top Pill Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white/90 px-4 py-1.5 backdrop-blur-md shadow-xs mb-6">
        <span class="h-2 w-2 rounded-full bg-blue-600 animate-pulse"></span>
        <span class="font-ibm-plex-mono text-xs font-medium tracking-wide text-background-13/80 uppercase">
          Módulo 03 · Desarrollo Web & Landing Pages
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-sora text-4xl sm:text-6xl lg:text-[62px] font-bold tracking-tight text-background-13 leading-[1.12] mb-6">
        Una web que represente tu empresa y <span class="bg-gradient-to-r from-background-13 via-blue-600 to-background-13 bg-clip-text text-transparent">convierta visitantes</span> en oportunidades.
      </h1>

      <!-- Subheadline -->
      <p class="font-inter-tight text-lg sm:text-xl text-background-13/75 max-w-3xl mx-auto mb-9 leading-relaxed">
        Diseñamos experiencias digitales claras, ultra rápidas y pensadas para generar confianza inmediata, explicar tu propuesta de valor y facilitar el contacto comercial por WhatsApp o formulario.
      </p>

      <!-- Dual Commercial CTA (WhatsApp Web context + Contact form) -->
      <div class="mb-12">
        <DualCTA
          whatsappContext="web"
          whatsappText="Cotizar Proyecto Web"
          emailText="Solicitar Propuesta por Email"
          emailHref="#contacto"
          centered={true}
        />
      </div>

      <!-- Trust Pillars -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-y-3 gap-x-8 text-xs font-ibm-plex-mono text-background-13/60 border-t border-black/5">
        <div class="flex items-center gap-2">
          <span class="text-emerald-500 font-bold">✓</span>
          <span>Velocidad Extrema (Astro 5 Islands)</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-500 font-bold">✓</span>
          <span>Mobile First & CRO Riguroso</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-500 font-bold">✓</span>
          <span>Conexión Directa a WhatsApp & CRM</span>
        </div>
      </div>

    </div>

    <!-- Interactive Browser & Mobile Mockup Showcase -->
    <div class="mt-14 relative mx-auto max-w-5xl">
      <div class="relative rounded-[24px] border border-black/10 bg-white/95 p-4 sm:p-6 shadow-[0_20px_50px_-15px_rgba(0,0,0,0.08)] backdrop-blur-xl">
        
        <!-- Showcase Top Navigation Bar -->
        <div class="flex flex-wrap items-center justify-between border-b border-black/5 pb-4 gap-3">
          <div class="flex items-center gap-2">
            <div class="h-3 w-3 rounded-full bg-red-400/80"></div>
            <div class="h-3 w-3 rounded-full bg-amber-400/80"></div>
            <div class="h-3 w-3 rounded-full bg-emerald-400/80"></div>
            <span class="ml-2 font-ibm-plex-mono text-xs text-background-13/50">https://tuempresa.com // high-conversion-experience</span>
          </div>

          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 font-ibm-plex-mono text-xs font-medium">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-ping"></span>
              Lighthouse 100 / 100
            </span>
            <span class="hidden sm:inline-block font-ibm-plex-mono text-xs text-background-13/40">Vercel Edge Global CDN</span>
          </div>
        </div>

        <!-- 4 Key Architecture Metrics Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5 pt-5 mb-6">
          
          <div class="rounded-2xl border border-black/5 bg-slate-50/80 p-3.5 transition-all hover:bg-white hover:shadow-xs">
            <div class="flex items-center justify-between mb-1.5 text-background-13/60">
              <span class="font-ibm-plex-mono text-[11px] uppercase tracking-wider font-medium">Rendimiento</span>
              <Gauge class="w-4 h-4 text-emerald-600" />
            </div>
            <div class="font-sora text-2xl font-bold text-background-13">100/100</div>
            <div class="font-inter-tight text-xs text-emerald-600 font-medium mt-0.5">Google Lighthouse Score</div>
          </div>

          <div class="rounded-2xl border border-black/5 bg-slate-50/80 p-3.5 transition-all hover:bg-white hover:shadow-xs">
            <div class="flex items-center justify-between mb-1.5 text-background-13/60">
              <span class="font-ibm-plex-mono text-[11px] uppercase tracking-wider font-medium">Tiempo de Carga</span>
              <Zap class="w-4 h-4 text-blue-600" />
            </div>
            <div class="font-sora text-2xl font-bold text-background-13">&lt; 0.6s</div>
            <div class="font-inter-tight text-xs text-blue-600 font-medium mt-0.5">Time to Interactive (TTI)</div>
          </div>

          <div class="rounded-2xl border border-black/5 bg-slate-50/80 p-3.5 transition-all hover:bg-white hover:shadow-xs">
            <div class="flex items-center justify-between mb-1.5 text-background-13/60">
              <span class="font-ibm-plex-mono text-[11px] uppercase tracking-wider font-medium">Mobile UX</span>
              <Smartphone class="w-4 h-4 text-opai-purple" />
            </div>
            <div class="font-sora text-2xl font-bold text-background-13">100%</div>
            <div class="font-inter-tight text-xs text-opai-purple font-medium mt-0.5">Diseño Mobile-First Nativo</div>
          </div>

          <div class="rounded-2xl border border-black/5 bg-slate-50/80 p-3.5 transition-all hover:bg-white hover:shadow-xs">
            <div class="flex items-center justify-between mb-1.5 text-background-13/60">
              <span class="font-ibm-plex-mono text-[11px] uppercase tracking-wider font-medium">Conversión CRO</span>
              <CheckCircle2 class="w-4 h-4 text-amber-500" />
            </div>
            <div class="font-sora text-2xl font-bold text-background-13">+210%</div>
            <div class="font-inter-tight text-xs text-amber-600 font-medium mt-0.5">Captura Dual de Contacto</div>
          </div>

        </div>

        <!-- Split View: Desktop Architecture + Mobile Preview -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
          
          <!-- Left: Desktop Hero Mockup with Code Highlights -->
          <div class="lg:col-span-8 rounded-2xl border border-black/5 bg-slate-50 p-5 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="font-ibm-plex-mono text-xs font-semibold text-blue-600 uppercase">Arquitectura Moderna Astro 5</span>
                <span class="text-xs px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 font-medium">Zero-JS por defecto</span>
              </div>
              <h3 class="font-sora text-lg font-bold text-background-13 mb-2">
                Sin plugins pesados de WordPress ni plantillas lentas.
              </h3>
              <p class="font-inter-tight text-xs sm:text-sm text-background-13/70 mb-4 leading-relaxed">
                Construimos sobre Astro y Tailwind CSS, eliminando código innecesario. Tu página carga al instante incluso en redes móviles 4G lentas, reteniendo el 100% de los visitantes que envías desde pauta publicitaria.
              </p>
            </div>

            <div class="grid grid-cols-2 gap-2 text-xs font-ibm-plex-mono">
              <div class="bg-white p-2.5 rounded-xl border border-black/5 flex items-center justify-between">
                <span class="text-background-13/60">Estructura SEO:</span>
                <span class="font-semibold text-emerald-600">Schema.org JSON-LD</span>
              </div>
              <div class="bg-white p-2.5 rounded-xl border border-black/5 flex items-center justify-between">
                <span class="text-background-13/60">Integración CRM:</span>
                <span class="font-semibold text-blue-600">HubSpot / Make / CAPI</span>
              </div>
            </div>
          </div>

          <!-- Right: Mobile Device Frame Snapshot -->
          <div class="lg:col-span-4 rounded-2xl border border-black/5 bg-gradient-to-b from-slate-900 to-black text-white p-5 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3 text-white/60">
                <span class="font-ibm-plex-mono text-xs text-opai-purple uppercase font-semibold">Experiencia Móvil</span>
                <Smartphone class="w-4 h-4 text-white/40" />
              </div>
              <div class="font-sora text-base font-bold text-white mb-2">
                Barra Sticky de Conversión
              </div>
              <p class="font-inter-tight text-xs text-white/70 leading-relaxed mb-4">
                El 82% del tráfico navega desde su celular. Incluimos botones flotantes contextuales de WhatsApp y llamada permanente para cerrar leads al instante.
              </p>
            </div>

            <div class="p-2.5 rounded-xl bg-white/10 border border-white/10 flex items-center justify-between text-xs font-ibm-plex-mono text-white/90">
              <span class="flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                <span>Mobile Sticky Bar</span>
              </span>
              <span class="text-emerald-400 font-semibold">Activo</span>
            </div>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>
