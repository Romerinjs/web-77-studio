---
// src/components/web/WebPainPointsSection.astro
import { ArrowRight, ChevronDown } from 'lucide-astro';

const painPoints = [
  {
    symptom: "Oferta confusa e indescifrable",
    consequence: "El visitante entra, no entiende qué hace tu empresa en menos de 5 segundos y se va con la competencia.",
    fix: "Titulares directos y arquitectura orientada a claridad absoluta."
  },
  {
    symptom: "Lentitud de carga y peso excesivo",
    consequence: "Cada segundo extra de carga reduce las conversiones un 20%. WordPress con 30 plugins destruye tu pauta.",
    fix: "Arquitectura Astro 5 con carga < 0.8s y 0 JS residual."
  },
  {
    symptom: "Pésima experiencia en celulares",
    consequence: "Texto diminuto, popups molestos y botones incómodos arruinan el 80% de tus visitas móviles.",
    fix: "Diseño Mobile-First con barra flotante de WhatsApp y llamada."
  },
  {
    symptom: "Formularios eternos sin WhatsApp",
    consequence: "Pedir 10 datos espanta a prospectos calificados que solo buscaban una respuesta rápida.",
    fix: "Conversión Dual: Formulario simple + Enlace directo a WhatsApp."
  },
  {
    symptom: "Cero integración con ventas",
    consequence: "Mensajes que llegan a correos no leídos y se responden 24h después cuando el lead ya contrató a otro.",
    fix: "Conexión instantánea a WhatsApp CRM y alertas en tiempo real."
  }
];
---

<section class="py-24 bg-white relative overflow-hidden">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header (Centered) -->
    <div class="text-center max-w-4xl mx-auto mb-14 sm:mb-16">
      <h2 data-text-reveal class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
        ¿Tu web actual genera ventas o solo te cuesta dinero?
      </h2>
      <p data-opai-animate data-delay="0.2" class="font-inter-tight text-base sm:text-lg text-background-13/75 leading-relaxed max-w-3xl mx-auto">
        Tener una página web no garantiza resultados. La mayoría de los sitios corporativos tienen fugas silenciosas de clientes por errores de diseño y arquitectura.
      </p>
    </div>

    <!-- 5x1 Horizontal Grid with Interactive Accordion Expansion -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-5 items-start mb-14" id="web-pain-points-grid">
      {painPoints.map((item, index) => (
        <div 
          data-opai-animate
          data-delay={(0.1 * (index + 1)).toFixed(1)}
          class="pain-card group rounded-[22px] border border-stroke-2/60 border-b-2 border-b-transparent bg-slate-50/70 p-5 sm:p-6 transition-all duration-300 hover:bg-white hover:shadow-md hover:border-black/15 hover:border-b-opai-purple flex flex-col justify-between cursor-pointer select-none"
          data-pain-index={index}
        >
          <!-- Top Content: Symptom & Consequence -->
          <div>
            <h3 class="font-sora text-base sm:text-lg font-bold text-background-13 mb-2.5 leading-snug group-hover:text-opai-purple transition-colors">
              {item.symptom}
            </h3>
            <p class="font-inter-tight text-xs sm:text-sm text-background-13/70 leading-relaxed mb-4">
              {item.consequence}
            </p>
          </div>

          <!-- Expandable Solution Content (Without "Solución 77" tag) -->
          <div class="accordion-content grid grid-rows-[0fr] transition-all duration-300 ease-out">
            <div class="overflow-hidden">
              <div class="pt-3 pb-1 border-t border-black/5">
                <p class="font-inter-tight text-xs sm:text-sm font-medium text-background-13 leading-relaxed bg-white p-3 rounded-xl border border-black/5 shadow-2xs">
                  {item.fix}
                </p>
              </div>
            </div>
          </div>

          <!-- Bottom Toggle Action Bar -->
          <div class="flex items-center justify-between pt-3 mt-3 border-t border-black/5 text-background-13/60 font-ibm-plex-mono text-xs">
            <span class="toggle-text font-medium group-hover:text-opai-purple transition-colors">
              Ver solución
            </span>
            <div class="accordion-chevron p-1 rounded-full bg-black/5 group-hover:bg-opai-purple/10 group-hover:text-opai-purple transition-all duration-300">
              <ChevronDown class="h-3.5 w-3.5" />
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA Prompt -->
    <div data-opai-animate data-delay="0.6" class="text-center">
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 font-ibm-plex-mono text-xs uppercase tracking-wider bg-background-13 hover:bg-black text-white px-6 py-3.5 rounded-xl transition-all font-medium"
      >
        <span>Solicitar Auditoría Gratuita de tu Web Actual</span>
        <ArrowRight class="h-4 w-4 text-opai-purple" />
      </a>
    </div>

  </div>
</section>

<style>
  .pain-card.is-open {
    background-color: #ffffff;
    box-shadow: 0 8px 25px -4px rgba(0, 0, 0, 0.08);
    border-color: rgba(0, 0, 0, 0.15);
    border-bottom-color: var(--color-opai-purple, #8d59ff);
  }

  .pain-card.is-open .accordion-chevron {
    transform: rotate(180deg);
    background-color: rgba(141, 89, 255, 0.15);
    color: var(--color-opai-purple, #8d59ff);
  }

  .pain-card.is-open .toggle-text {
    color: var(--color-opai-purple, #8d59ff);
  }

  .pain-card.is-open .accordion-content {
    grid-template-rows: 1fr;
  }
</style>

<script>
  function initPainPointsGridAccordion() {
    const grid = document.getElementById('web-pain-points-grid');
    if (!grid) return;

    const cards = grid.querySelectorAll('.pain-card');

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const isOpen = card.classList.contains('is-open');
        const toggleText = card.querySelector('.toggle-text');

        // Toggle clicked card
        if (isOpen) {
          card.classList.remove('is-open');
          if (toggleText) toggleText.textContent = 'Ver solución';
        } else {
          card.classList.add('is-open');
          if (toggleText) toggleText.textContent = 'Ocultar';
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPainPointsGridAccordion);
  } else {
    initPainPointsGridAccordion();
  }
  document.addEventListener('astro:page-load', initPainPointsGridAccordion);
</script>
