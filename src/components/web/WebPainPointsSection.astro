---
// src/components/web/WebPainPointsSection.astro
import { AlertCircle, CheckCircle2, Flame, ArrowRight } from 'lucide-astro';

const painPoints = [
  {
    number: "01",
    symptom: "Oferta confusa e indescifrable",
    consequence: "El visitante entra, no entiende qué hace tu empresa en menos de 5 segundos y se va con la competencia.",
    fix: "Titulares directos y arquitectura de información orientada a claridad absoluta."
  },
  {
    number: "02",
    symptom: "Lentitud de carga y peso excesivo",
    consequence: "Cada segundo extra de carga reduce las conversiones un 20%. WordPress con 30 plugins destruye tu presupuesto de anuncios.",
    fix: "Arquitectura Astro 5 con carga en &lt;0.8s y 0 JavaScript residual."
  },
  {
    number: "03",
    symptom: "Pésima experiencia en teléfonos móviles",
    consequence: "Texto diminuto, popups molestos y botones que no se pueden pulsar con el pulgar arruinan el 80% de tus visitas.",
    fix: "Diseño Mobile-First con barra sticky flotante de WhatsApp y llamada."
  },
  {
    number: "04",
    symptom: "Formularios interminables y sin WhatsApp",
    consequence: "Pedir 10 datos en un formulario estático espanta a prospectos calificados que solo querían una respuesta rápida.",
    fix: "Conversión Dual: Formulario simplificado + Enlace contextual a WhatsApp."
  },
  {
    number: "05",
    symptom: "Cero integración con tu equipo comercial",
    consequence: "Los mensajes llegan a correos no leídos y se responden 24 horas después cuando el cliente ya contrató a otro.",
    fix: "Conexión instantánea a WhatsApp Business, CRM y notificaciones en tiempo real."
  }
];
---

<section class="py-24 bg-white relative overflow-hidden">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 font-ibm-plex-mono text-xs font-semibold uppercase tracking-wider text-rose-600 mb-3">
        <span>// Diagnóstico de Fricción Web</span>
      </div>
      <h2 class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
        ¿Tu web actual genera ventas o solo te cuesta dinero?
      </h2>
      <p class="font-inter-tight text-lg text-background-13/75 leading-relaxed">
        Tener una página web no garantiza resultados. La mayoría de los sitios corporativos tienen fugas silenciosas de clientes por errores de diseño y arquitectura.
      </p>
    </div>

    <!-- 5 Pain Points List & Transformation Grid -->
    <div class="space-y-4 max-w-4xl mx-auto mb-14">
      {painPoints.map((item) => (
        <div class="rounded-[20px] border border-stroke-2/60 bg-slate-50/70 p-5 sm:p-6 transition-all hover:bg-white hover:shadow-md hover:border-black/20">
          <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
            
            <div class="flex items-start gap-4">
              <span class="font-ibm-plex-mono text-lg font-bold text-rose-600 bg-rose-100/70 h-9 w-9 rounded-xl flex items-center justify-center shrink-0">
                {item.number}
              </span>
              <div>
                <h3 class="font-sora text-base sm:text-lg font-bold text-background-13 mb-1">
                  {item.symptom}
                </h3>
                <p class="font-inter-tight text-xs sm:text-sm text-background-13/70 leading-relaxed">
                  {item.consequence}
                </p>
              </div>
            </div>

            <div class="md:text-right shrink-0 pt-2 md:pt-0 border-t md:border-t-0 border-black/5">
              <span class="inline-flex items-center gap-1.5 font-ibm-plex-mono text-xs font-semibold text-emerald-700 bg-emerald-100/70 px-3 py-1.5 rounded-lg">
                <CheckCircle2 class="h-3.5 w-3.5" />
                <span>Solución 77: {item.fix}</span>
              </span>
            </div>

          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA Prompt -->
    <div class="text-center">
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 font-ibm-plex-mono text-xs uppercase tracking-wider bg-background-13 hover:bg-black text-white px-6 py-3.5 rounded-xl transition-all font-medium"
      >
        <span>Solicitar Auditoría Gratuita de tu Web Actual</span>
        <ArrowRight class="h-4 w-4 text-opai-purple" />
      </a>
    </div>

  </div>
</section>
