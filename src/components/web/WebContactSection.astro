---
// src/components/web/WebContactSection.astro
import ContactForm from '@/components/ContactForm.astro';
import { getWhatsAppUrl } from '@/utils/whatsapp';
import { ArrowRight, ShieldCheck, Zap, Code2 } from 'lucide-astro';

const whatsappUrl = getWhatsAppUrl('web');
---

<section id="contacto" class="py-20 sm:py-28 bg-slate-50 relative overflow-hidden border-t border-black/5">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Web Value Proposition & Direct WhatsApp -->
      <div class="lg:col-span-5 space-y-8">
        
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-3.5 py-1 font-ibm-plex-mono text-xs text-blue-600 mb-4 shadow-2xs">
            <span>COTIZACIÓN & DIAGNÓSTICO WEB</span>
          </div>
          <h2 class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
            Construyamos la web que tu empresa merece.
          </h2>
          <p class="font-inter-tight text-base text-background-13/75 leading-relaxed">
            Conversemos sobre los objetivos de tu sitio web o landing page, analicemos tu arquitectura actual y diseñemos una propuesta técnica y visual a la medida de tu negocio.
          </p>
        </div>

        <!-- Direct WhatsApp Card tailored for Web -->
        <div class="rounded-[24px] border border-blue-200 bg-white p-7 shadow-[0_10px_30px_rgba(37,99,235,0.08)]">
          <div class="flex items-center gap-3 mb-4">
            <div class="h-10 w-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-xs">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
              </svg>
            </div>
            <div>
              <span class="font-sora font-bold text-base text-background-13 block leading-tight">
                Chat Directo con Ingeniería
              </span>
              <span class="font-ibm-plex-mono text-xs text-blue-600 font-medium">
                WhatsApp Business · Asesoría Inmediata
              </span>
            </div>
          </div>

          <p class="font-inter-tight text-xs sm:text-sm text-background-13/70 mb-5 leading-relaxed">
            Mensaje prellenado para consultar sobre desarrollo de landings, web corporativa o modernización de tu sitio actual.
          </p>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white py-3.5 px-5 rounded-xl font-ibm-plex-mono text-sm font-semibold transition-all shadow-md active:scale-98"
          >
            <span>Conversar por WhatsApp</span>
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>

        <!-- Trust Badges for Web Inquiries -->
        <div class="space-y-3 font-ibm-plex-mono text-xs text-background-13/60">
          <div class="flex items-center gap-2">
            <ShieldCheck class="w-4 h-4 text-emerald-600" />
            <span>Código 100% propio y transferible, sin ataduras a plataformas propietarias</span>
          </div>
          <div class="flex items-center gap-2">
            <Zap class="w-4 h-4 text-amber-500" />
            <span>Garantía de velocidad y soporte técnico continuo</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Lead Form prefilled for Web -->
      <div class="lg:col-span-7">
        <ContactForm originPage="web" />
      </div>

    </div>

  </div>
</section>
