---
// src/components/DualCTA.astro
import { getWhatsAppUrl, type WhatsAppContext } from '@/utils/whatsapp';

interface Props {
  whatsappContext?: WhatsAppContext;
  whatsappMessage?: string;
  whatsappText?: string;
  emailText?: string;
  emailHref?: string;
  className?: string;
  centered?: boolean;
}

const {
  whatsappContext = 'home',
  whatsappMessage,
  whatsappText = 'Hablar por WhatsApp',
  emailText = 'Quiero que me contacten',
  emailHref = '#contacto',
  className = '',
  centered = true
} = Astro.props;

const finalWhatsAppUrl = whatsappMessage 
  ? getWhatsAppUrl(whatsappMessage)
  : getWhatsAppUrl(whatsappContext);
---

<div class={`flex flex-col sm:flex-row items-center gap-3.5 ${centered ? 'justify-center' : 'justify-start'} ${className}`}>
  <!-- Botón Primario: WhatsApp Prellenado -->
  <a
    href={finalWhatsAppUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-opai-purple hover:bg-opai-purple-hover text-white px-6 py-3.5 rounded-xl font-ibm-plex-mono text-sm font-medium transition-all shadow-[0_4px_14px_rgba(124,58,237,0.3)] hover:shadow-[0_6px_20px_rgba(124,58,237,0.4)] active:scale-[0.98]"
  >
    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
    </svg>
    <span>{whatsappText}</span>
  </a>

  <!-- Botón Secundario: Formulario / Email -->
  <a
    href={emailHref}
    class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-background-13 hover:bg-black text-white px-6 py-3.5 rounded-xl font-ibm-plex-mono text-sm font-medium transition-all shadow-sm hover:shadow-md active:scale-[0.98] border border-white/10"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
    </svg>
    <span>{emailText}</span>
  </a>
</div>
