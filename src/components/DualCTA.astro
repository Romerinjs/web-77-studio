---
// src/components/DualCTA.astro
import { getWhatsAppUrl, type WhatsAppContext } from '@/utils/whatsapp';
import { uiTranslations, type SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  whatsappContext?: WhatsAppContext;
  whatsappMessage?: string;
  whatsappText?: string;
  emailText?: string;
  emailHref?: string;
  className?: string;
  centered?: boolean;
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const t = uiTranslations[currentLang];

const {
  whatsappContext = 'home',
  whatsappMessage,
  whatsappText = t.cta.whatsappDefault,
  emailText = t.cta.emailDefault,
  emailHref = '#contacto',
  className = '',
  centered = true
} = Astro.props;

const finalWhatsAppUrl = whatsappMessage 
  ? getWhatsAppUrl(whatsappMessage, undefined, currentLang)
  : getWhatsAppUrl(whatsappContext, undefined, currentLang);
---

<div class={`flex flex-col sm:flex-row items-center gap-4 ${centered ? 'justify-center' : 'justify-start'} ${className}`}>
  <!-- Botón Primario: WhatsApp Prellenado (Estilo Pill Premium) -->
  <a
    href={finalWhatsAppUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="w-full sm:w-auto inline-block"
  >
    <div class="bg-background-4 group button font-ibm-plex-mono text-sm text-background-11 flex h-13 w-full items-center rounded-2xl p-1 cursor-pointer">
      <!-- Icon Wrapper -->
      <div class="button-icon relative z-20 h-11 w-15 overflow-hidden rounded-[13px] flex items-center justify-center">
        <div class="bg-opai-purple absolute inset-0 z-20 flex size-full items-center justify-center shadow-[inset_0_3px_10px_rgba(255,255,255,0.4)]">
          <svg class="w-5 h-5 fill-white" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
        </div>
      </div>
      <!-- Text -->
      <span class="button-text shrink-0 px-5 font-medium">{whatsappText}</span>
    </div>
  </a>

  <!-- Botón Secundario: Formulario / Email (Estilo Capsule Premium) -->
  <a
    href={emailHref}
    class="w-full sm:w-auto inline-block"
  >
    <div class="bg-background-13/10 hover:bg-background-13 group font-ibm-plex-mono text-sm text-background-13 hover:text-white flex h-13 w-full items-center justify-center rounded-2xl px-6 transition-all duration-300 cursor-pointer border border-black/5 hover:border-transparent active:scale-[0.98]">
      <span>{emailText}</span>
    </div>
  </a>
</div>
